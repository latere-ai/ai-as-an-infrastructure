@article{hendrycks2021math,
  title   = {Measuring Mathematical Problem Solving with the MATH Dataset},
  author  = {Hendrycks, Dan and Burns, Collin and Kadavath, Saurav and Arora, Akul and Basart, Steven and Tang, Eric and Song, Dawn and Steinhardt, Jacob},
  year    = {2021},
  journal = {arXiv preprint arXiv:2103.03874},
  eprint  = {2103.03874},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2103.03874},
  tldr    = {The MATH dataset introduces 12,500 competition mathematics problems with step-by-step solutions, showing that large Transformer scaling alone cannot solve challenging mathematical reasoning.},
  tldr-zh = {MATH 数据集包含 12,500 道竞赛数学题及逐步解答，表明仅靠 Transformer 扩展律无法解决高难度数学推理问题。}
}

@article{rein2023gpqa,
  title   = {GPQA: A Graduate-Level Google-Proof Q\&A Benchmark},
  author  = {Rein, David and Hou, Betty Li and Stickland, Asa Cooper and Petty, Jackson and Pang, Richard Yuanzhe and Dirani, Julien and Michael, Julian and Bowman, Samuel R.},
  year    = {2023},
  journal = {arXiv preprint arXiv:2311.12022},
  eprint  = {2311.12022},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2311.12022},
  tldr    = {GPQA is a 448-question graduate-level benchmark in biology, physics, and chemistry where PhD experts reach 65% accuracy but skilled non-experts with web access reach only 34%, designed to support scalable oversight research.},
  tldr-zh = {GPQA 是一个包含 448 道生物、物理和化学研究生级别题目的基准，博士专家准确率为 65%，而可上网的非专家仅达 34%，旨在支持可扩展监督（scalable oversight）研究。}
}

@article{jimenez2023swebench,
  title   = {SWE-bench: Can Language Models Resolve Real-World GitHub Issues?},
  author  = {Jimenez, Carlos E. and Yang, John and Wettig, Alexander and Yao, Shunyu and Pei, Kexin and Press, Ofir and Narasimhan, Karthik},
  year    = {2023},
  journal = {arXiv preprint arXiv:2310.06770},
  eprint  = {2310.06770},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2310.06770},
  tldr    = {SWE-bench is a benchmark of 2,294 real GitHub issue-resolution tasks across 12 Python repositories, where models must edit codebases to pass tests, and top models like Claude 2 solve only 1.96%.},
  tldr-zh = {SWE-bench 是一个包含来自 12 个 Python 仓库的 2,294 个真实 GitHub 问题修复任务的基准，要求模型编辑代码库以通过测试，最优模型 Claude 2 仅能解决 1.96% 的问题。}
}

@article{hsieh2024ruler,
  title   = {RULER: What's the Real Context Size of Your Long-Context Language Models?},
  author  = {Hsieh, Cheng-Ping and Sun, Simeng and Kriman, Samuel and Acharya, Shantanu and Rekesh, Dima and Jia, Fei and Zhang, Yang and Ginsburg, Boris},
  year    = {2024},
  journal = {arXiv preprint arXiv:2404.06654},
  eprint  = {2404.06654},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2404.06654},
  tldr    = {RULER is a synthetic benchmark with flexible context length and task complexity that reveals most long-context LLMs fail well below their claimed context sizes on tasks beyond simple retrieval.},
  tldr-zh = {RULER 是一个可配置上下文长度和任务复杂度的合成基准，揭示大多数长上下文大语言模型在超出简单检索的任务上，实际有效上下文长度远低于其宣称值。}
}

@article{mialon2023gaia,
  title   = {GAIA: a benchmark for General AI Assistants},
  author  = {Mialon, Gr{\'e}goire and Fourrier, Cl{\'e}mentine and Swift, Craig and Wolf, Thomas and LeCun, Yann and Scialom, Thomas},
  year    = {2023},
  journal = {arXiv preprint arXiv:2311.12983},
  eprint  = {2311.12983},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2311.12983},
  tldr    = {GAIA is a benchmark of 466 real-world questions for general AI assistants, where humans score 92% but GPT-4 with plugins scores under 30% on the easiest level.},
  tldr-zh = {GAIA 是面向通用 AI 助手的基准测试，包含 466 道真实世界问题，人类得分 92%，而配备插件的 GPT-4 在最简单一级的得分不超过 30%。}
}

@article{yao2024taubench,
  title   = {{\tau}-bench: A Benchmark for Tool-Agent-User Interaction in Real-World Domains},
  author  = {Yao, Shunyu and Shinn, Noah and Razavi, Pedram and Narasimhan, Karthik},
  year    = {2024},
  journal = {arXiv preprint arXiv:2406.12045},
  eprint  = {2406.12045},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2406.12045},
  tldr    = {τ-bench is a benchmark for evaluating language agents on tool use and dynamic user interaction under domain-specific policies, introducing a pass^k metric for reliability, revealing that gpt-4o succeeds on fewer than 50% of tasks.},
  tldr-zh = {τ-bench 是一个评测语言智能体在领域特定策略下工具调用与动态用户交互能力的基准，引入 pass^k 一致性指标，发现 gpt-4o 的任务成功率不足 50%。}
}

@article{zhou2023webarena,
  title   = {WebArena: A Realistic Web Environment for Building Autonomous Agents},
  author  = {Zhou, Shuyan and Xu, Frank F. and Zhu, Hao and Zhou, Xuhui and Lo, Robert and Sridhar, Abishek and Cheng, Xianyi and Ou, Tianyue and Bisk, Yonatan and Fried, Daniel and Alon, Uri and Neubig, Graham},
  year    = {2023},
  journal = {arXiv preprint arXiv:2307.13854},
  eprint  = {2307.13854},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2307.13854},
  tldr    = {WebArena is a realistic, self-hostable web environment with 812 long-horizon benchmark tasks for evaluating autonomous agents, where the best GPT-4 agent reaches only 14.41% success versus 78.24% for humans.},
  tldr-zh = {WebArena 是一个真实可复现的自托管网络环境，含 812 个长时域基准任务，用于评测自主智能体，最强 GPT-4 智能体的端到端成功率仅为 14.41%，而人类为 78.24%。}
}

@article{chiang2024chatbot,
  title   = {Chatbot Arena: An Open Platform for Evaluating LLMs by Human Preference},
  author  = {Chiang, Wei-Lin and Zheng, Lianmin and Sheng, Ying and Angelopoulos, Anastasios Nikolas and Li, Tianle and Li, Dacheng and Zhang, Hao and Zhu, Banghua and Jordan, Michael and Gonzalez, Joseph E. and Stoica, Ion},
  year    = {2024},
  journal = {arXiv preprint arXiv:2403.04132},
  eprint  = {2403.04132},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2403.04132},
  tldr    = {Chatbot Arena is an open crowdsourced platform that evaluates LLMs via pairwise human preference votes, using Bradley-Terry ranking over 240K crowd-collected comparisons.},
  tldr-zh = {Chatbot Arena 是一个开放的众包平台，通过成对比较让用户投票，基于 Bradley-Terry 模型对大语言模型（LLM）进行人类偏好排名，累计收集超过 24 万票。}
}

@article{shi2023detecting,
  title   = {Detecting Pretraining Data from Large Language Models},
  author  = {Shi, Weijia and Ajith, Anirudh and Xia, Mengzhou and Huang, Yangsibo and Liu, Daogao and Blevins, Terra and Chen, Danqi and Zettlemoyer, Luke},
  year    = {2023},
  journal = {arXiv preprint arXiv:2310.16789},
  eprint  = {2310.16789},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2310.16789},
  tldr    = {MIN-K% PROB detects whether a text was in an LLM's pretraining data by averaging the log-probabilities of the lowest-probability tokens, requiring no reference model or pretraining corpus access.},
  tldr-zh = {MIN-K% PROB 通过对大语言模型中概率最低的词元取平均对数概率，无需参考模型或预训练语料访问权限，即可推断文本是否属于预训练数据的成员推断方法。}
}

@article{xie2024osworld,
  title   = {OSWorld: Benchmarking Multimodal Agents for Open-Ended Tasks in Real Computer Environments},
  author  = {Xie, Tianbao and Zhang, Danyang and Chen, Jixuan and Li, Xiaochuan and Zhao, Siheng and Cao, Ruisheng and Hua, Toh Jing and Cheng, Zhoujun and Shin, Dongchan and Lei, Fangyu and Liu, Yitao and Xu, Yiheng and Zhou, Shuyan and Savarese, Silvio and Xiong, Caiming and Zhong, Victor and Yu, Tao},
  year    = {2024},
  journal = {arXiv preprint arXiv:2404.07972},
  eprint  = {2404.07972},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2404.07972},
  tldr    = {OSWorld introduces a scalable real-computer benchmark of 369 tasks across real OS environments, where the best LLM/VLM agent achieves only 12.24% success versus 72.36% for humans.},
  tldr-zh = {OSWorld 提出了一个在真实操作系统环境中包含 369 个任务的可扩展基准测试，最佳 VLM 智能体仅取得 12.24% 的成功率，而人类可达 72.36%。}
}

@article{wei2025browsecomp,
  title   = {BrowseComp: A Simple Yet Challenging Benchmark for Browsing Agents},
  author  = {Wei, Jason and Sun, Zhiqing and Papay, Spencer and McKinney, Scott and Han, Jeffrey and Fulford, Isa and Chung, Hyung Won and Passos, Alex Tachard and Fedus, William and Glaese, Amelia},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.12516},
  eprint  = {2504.12516},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.12516},
  tldr    = {BrowseComp is a benchmark of 1,266 hard, verifiable web-search questions designed to measure the persistence and creativity of browsing agents, where only OpenAI Deep Research solves roughly half.},
  tldr-zh = {BrowseComp 是一个包含 1,266 道难题的基准，用于衡量浏览智能体在网络中持久搜索难以找到信息的能力，仅 OpenAI Deep Research 能解决约一半的问题。}
}
