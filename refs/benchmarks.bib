@article{heineman2025signal,
  title   = {Signal and Noise: A Framework for Reducing Uncertainty in Language Model Evaluation},
  author  = {Heineman, David and Hofmann, Valentin and Magnusson, Ian and Gu, Yuling and Smith, Noah A. and Hajishirzi, Hannaneh and Lo, Kyle and Dodge, Jesse},
  year    = {2025},
  journal = {arXiv preprint arXiv:2508.13144},
  eprint  = {2508.13144},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2508.13144},
  note    = {30 benchmarks, 375 models; signal-to-noise as a benchmark property},
  tldr    = {Signal is a benchmark's ability to separate stronger models from weaker ones and noise is its sensitivity to random variation between training steps; across 30 benchmarks and 375 open-weight models the ratio predicts which small-scale comparisons and scaling-law fits can be trusted.},
  tldr-zh = {信号指基准区分强弱模型的能力，噪声指它对训练步之间随机波动的敏感度；在 30 个基准和 375 个开放权重模型上，二者之比可以预测哪些小规模比较和缩放律拟合值得相信。}
}
