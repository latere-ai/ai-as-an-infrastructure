@article{villalobos2024data,
  title         = {Will We Run Out of Data? Limits of LLM Scaling Based on Human-Generated Data},
  author        = {Villalobos, Pablo and Ho, Anson and Sevilla, Jaime and Besiroglu, Tamay and Heim, Lennart and Hobbhahn, Marius},
  year          = {2024},
  journal       = {arXiv preprint arXiv:2211.04325},
  eprint        = {2211.04325},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2211.04325},
  note          = {the \textasciitilde{}300T-token stock and the 2026{-}{-}2032 exhaustion window},
  note-zh       = {约 300T 词元的存量与 2026{-}{-}2032 的耗尽窗口},
  tldr    = {This paper forecasts that LLM training demand will exhaust all available public human-generated text data between 2026 and 2032, and surveys synthetic data and transfer learning as potential mitigations.},
  tldr-zh = {本文预测，按当前大语言模型发展趋势，训练数据需求将在 2026 至 2032 年间耗尽全部公开人类生成文本，并探讨合成数据与迁移学习作为应对策略。}
}

@article{kalai2025hallucinate,
  title         = {Why Language Models Hallucinate},
  author        = {Kalai, Adam Tauman and Nachum, Ofir and Vempala, Santosh and Zhang, Edwin},
  year          = {2025},
  journal       = {arXiv preprint arXiv:2509.04664},
  eprint        = {2509.04664},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2509.04664},
  note          = {hallucination as a statistical property of the objective, sustained by binary-graded evals},
  note-zh       = {幻觉作为目标函数的统计属性，由二元打分的评测维系},
  tldr    = {This paper argues that LLM hallucinations arise from statistical pressures during pretraining (via a reduction to binary classification) and persist because most benchmarks reward guessing over expressing uncertainty.},
  tldr-zh = {本文通过将大语言模型（LLM）生成错误归约为二分类问题，论证幻觉在预训练阶段由统计压力产生，并因主流基准奖励猜测而非表达不确定性而在后训练阶段持续存在。}
}

@inproceedings{yue2025rlvr,
  title         = {Does Reinforcement Learning Really Incentivize Reasoning Capacity in LLMs Beyond the Base Model?},
  author        = {Yue, Yang and Chen, Zhiqi and Lu, Rui and Zhao, Andrew and Wang, Zhaokai and Yue, Yang and Song, Shiji and Huang, Gao},
  year          = {2025},
  booktitle     = {Advances in Neural Information Processing Systems},
  volume        = {38},
  eprint        = {2504.13837},
  archivePrefix = {arXiv},
  url           = {https://proceedings.neurips.cc/paper_files/paper/2025/hash/537d5aa768c2d534016a4d06f87bc8fb-Abstract-Conference.html},
  note          = {the elicitation-versus-creation debate},
  note-zh       = {激发对创造之争},
  tldr    = {RLVR improves sampling efficiency toward correct answers at low pass@k but does not expand reasoning beyond the base model's existing distribution, which bounds RLVR-trained LLMs.},
  tldr-zh = {RLVR（可验证奖励的强化学习）提升了低 pass@k（至少一次成功率）下的采样效率，但不会产生超出基础模型分布的新推理能力，基础模型构成 RLVR 训练模型的推理上界。}
}

