@article{zheng2023judging,
  title   = {Judging LLM-as-a-Judge with MT-Bench and Chatbot Arena},
  author  = {Zheng, Lianmin and Chiang, Wei-Lin and Sheng, Ying and Zhuang, Siyuan and Wu, Zhanghao and Zhuang, Yonghao and Lin, Zi and Li, Zhuohan and Li, Dacheng and Xing, Eric P. and Zhang, Hao and Gonzalez, Joseph E. and Stoica, Ion},
  year    = {2023},
  journal = {arXiv preprint arXiv:2306.05685},
  eprint  = {2306.05685},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2306.05685},
  tldr    = {This paper introduces MT-bench and Chatbot Arena to validate LLM-as-a-judge, showing GPT-4 matches human preference ratings at over 80% agreement, making it a scalable alternative to human evaluation.},
  tldr-zh = {本文提出 MT-bench 和 Chatbot Arena 两个基准，验证大语言模型作为评判者的方法，证明 GPT-4 与人类偏好的一致率超过 80%，可作为人工评测的可扩展替代方案。}
}

@article{wang2023large,
  title   = {Large Language Models are not Fair Evaluators},
  author  = {Wang, Peiyi and Li, Lei and Chen, Liang and Cai, Zefan and Zhu, Dawei and Lin, Binghuai and Cao, Yunbo and Liu, Qi and Liu, Tianyu and Sui, Zhifang},
  year    = {2023},
  journal = {arXiv preprint arXiv:2305.17926},
  eprint  = {2305.17926},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.17926},
  tldr    = {This paper exposes a positional bias in LLM-as-judge evaluation where swapping response order causes GPT-4 and ChatGPT to reverse their verdicts, and proposes three calibration strategies to mitigate it.},
  tldr-zh = {本文揭示大语言模型作为评判者（LLM-as-judge）时存在严重的位置偏差，交换候选回复顺序会导致 GPT-4 和 ChatGPT 翻转评判结果，并提出三种校准策略加以缓解。}
}

