  author  = {Miller, Evan},
  year    = {2024},
  journal = {arXiv preprint arXiv:2411.00640},
  eprint  = {2411.00640},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2411.00640},
  note    = {error bars for LLM evals},
  note-zh = {为 LLM 评测加上误差棒},
  tldr    = {An Anthropic treatment of LLM evaluation as statistical inference: report standard errors, use clustered standard errors when questions come in groups, analyze paired differences between models, and plan sample sizes with power analysis.},
