% Bibliography for chapter "Adoption and Productivity".

@article{brynjolfsson2023generative,
  author    = {Brynjolfsson, Erik and Li, Danielle and Raymond, Lindsey},
  title     = {Generative AI at Work},
  year      = {2023},
  eprint    = {2304.11771},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2304.11771},
  note      = {field evidence from 5,172 customer-support agents},
  note-zh   = {5172 名客服坐席的现场证据},
  tldr      = {A staggered rollout of a conversational AI assistant raised customer-support productivity by 15 percent on average, with the largest gains for less experienced workers.},
  tldr-zh   = {一次对话式 AI 助手的分阶段上线平均提升客服生产率 15\%，收益最大的是经验较少的员工。}
}

@techreport{dellacqua2023navigating,
  author      = {Dell'Acqua, Fabrizio and McFowland, Edward and Mollick, Ethan and Lifshitz-Assaf, Hila and Kellogg, Katherine C. and Rajendran, Saran and Krayer, Lisa and Candelon, François and Lakhani, Karim R.},
  title       = {Navigating the Jagged Technological Frontier: Field Experimental Evidence of the Effects of Artificial Intelligence on Knowledge Worker Productivity and Quality},
  year        = {2023},
  institution = {Harvard Business School},
  url         = {https://www.hbs.edu/faculty/Pages/item.aspx?num=64700},
  note        = {758-worker field experiment on the jagged technology frontier},
  note-zh     = {758 名知识工作者的锯齿技术边界现场实验},
  tldr        = {The HBS field experiment finds large gains for tasks inside the AI capability frontier but worse accuracy on a task outside it, motivating the jagged-frontier framing.},
  tldr-zh     = {HBS 现场实验发现，AI 在能力边界内的任务上带来显著收益，但在边界外任务上降低正确率，从而提出锯齿技术边界框架。}
}

@article{dillon2025shifting,
  author    = {Dillon, Eleanor Wiske and Jaffe, Sonia and Immorlica, Nicole and Stanton, Christopher T.},
  title     = {Shifting Work Patterns with Generative AI},
  year      = {2025},
  eprint    = {2504.11436},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2504.11436},
  note      = {six-month randomized field experiment with 6,000 workers},
  note-zh   = {6000 名员工的六个月随机现场实验},
  tldr      = {A six-month RCT of 6,000 workers finds AI access mainly changes individually controlled work patterns, reducing email time among users but not meeting time.},
  tldr-zh   = {一项覆盖 6000 名员工、持续六个月的随机实验发现，AI 主要改变可由个人控制的工作模式，使使用者减少邮件时间，但没有显著减少会议时间。}
}

@article{becker2025measuring,
  author    = {Becker, Joel and Rush, Nate and Barnes, Elizabeth and Rein, David},
  title     = {Measuring the Impact of Early-2025 AI on Experienced Open-Source Developer Productivity},
  year      = {2025},
  eprint    = {2507.09089},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2507.09089},
  note      = {RCT on experienced open-source developers},
  note-zh   = {经验丰富开源开发者的随机实验},
  tldr      = {In an RCT on 16 experienced open-source developers and 246 tasks, early-2025 AI tools slowed completion time by 19 percent despite participants expecting speedups.},
  tldr-zh   = {一项针对 16 名经验丰富开源开发者和 246 个任务的随机实验发现，2025 年初的 AI 工具让完成时间变慢 19\%，尽管参与者预期会提速。}
}

