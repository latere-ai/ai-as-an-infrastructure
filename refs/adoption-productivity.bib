@article{patwardhan2025gdpval,
  author    = {Patwardhan, Tejal and Dias, Rachel and Proehl, Elizabeth and others},
  title     = {GDPval: Evaluating AI Model Performance on Real-World Economically Valuable Tasks},
  year      = {2025},
  eprint    = {2510.04374},
