  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2508.09224},
  note    = {safe-completions training, shipped in GPT-5},
  tldr    = {Safe-completions training replaces a binary refusal boundary with an output-centric learned objective; the reported GPT-5 experiments improve safety and helpfulness on dual-use prompts where intent-based refusal is brittle.},
