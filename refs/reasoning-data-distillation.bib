@article{zelikman2022star,
  title   = {STaR: Bootstrapping Reasoning With Reasoning},
  author  = {Zelikman, Eric and Wu, Yuhuai and Mu, Jesse and Goodman, Noah D.},
  year    = {2022},
  journal = {arXiv preprint arXiv:2203.14465},
  eprint  = {2203.14465},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2203.14465},
  tldr    = {STaR iteratively generates rationales, keeps those that lead to correct answers, and fine-tunes on the resulting traces to bootstrap reasoning from a small rationale seed set.},
  tldr-zh = {STaR 迭代生成 rationale，保留通向正确答案的轨迹，并在这些轨迹上微调，从少量 rationale 种子自举出推理能力。}
}

@article{yuan2023scaling,
  title   = {Scaling Relationship on Learning Mathematical Reasoning with Large Language Models},
  author  = {Yuan, Zheng and Yuan, Hongyi and Li, Chengpeng and Dong, Guanting and Lu, Keming and Tan, Chuanqi and Zhou, Chang and Zhou, Jingren},
  year    = {2023},
  journal = {arXiv preprint arXiv:2308.01825},
  eprint  = {2308.01825},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2308.01825},
  tldr    = {This paper studies scaling relationships for mathematical reasoning and introduces rejection sampling fine-tuning, which augments training data with verifier-selected correct reasoning paths.},
  tldr-zh = {本文研究数学推理学习的扩展关系，并提出拒绝采样微调，用验证器选出的正确推理路径扩充训练数据。}
}

@article{kimi2025k15,
  title   = {Kimi k1.5: Scaling Reinforcement Learning with LLMs},
  author  = {{Kimi Team} and Du, Angang and Gao, Bofei and Xing, Bowei and Jiang, Changjiu and Chen, Cheng and Li, Cheng and Xiao, Chenjun and Du, Chenzhuang and Liao, Chonghua and Tang, Chuning and Wang, Congcong and Zhang, Dehao and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2501.12599},
  eprint  = {2501.12599},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2501.12599},
  tldr    = {Kimi k1.5 reports a multimodal RL reasoning system that scales long-context RL without MCTS, value functions, or PRMs, and introduces long2short methods for short-CoT models.},
  tldr-zh = {Kimi k1.5 报告了一个多模态强化学习推理系统，在不依赖 MCTS、价值函数或 PRM 的情况下扩展长上下文 RL，并提出 long2short 方法改善短 CoT 模型。}
}

@article{yuan2025weak,
  title   = {Incentivizing Reasoning from Weak Supervision},
  author  = {Yuan, Yige and Xiao, Teng and Tao, Shuchang and Wang, Xue and Gao, Jinyang and Ding, Bolin and Xu, Bingbing},
  year    = {2025},
  journal = {arXiv preprint arXiv:2505.20072},
  eprint  = {2505.20072},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2505.20072},
  tldr    = {This paper studies weak-to-strong reasoning supervision and reports that weaker reasoners can recover most of the gains of expensive RL when supervising stronger students.},
  tldr-zh = {本文研究弱到强的推理监督，并报告较弱推理器监督更强学生时，可恢复昂贵强化学习的大部分收益。}
}

@article{guha2025openthoughts,
  title   = {OpenThoughts: Data Recipes for Reasoning Models},
  author  = {Guha, Etash and Marten, Ryan and Keh, Sedrick and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.04178},
  eprint  = {2506.04178},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.04178},
  note    = {OpenThoughts3-1.2M and OpenThinker3-7B; controlled data-recipe ablations at the million-trace scale},
  tldr    = {Over a thousand controlled ablations of the reasoning-data pipeline produce OpenThoughts3-1.2M; OpenThinker3-7B trained on it reaches 53\% on AIME 2025, showing scale plus curation beats tiny curated sets on open base models.},
  tldr-zh = {对推理数据流水线做上千次受控消融得到 OpenThoughts3-1.2M；在其上训练的 OpenThinker3-7B 在 AIME 2025 上达到 53\%，说明在开放基座上「规模加筛选」胜过小而精的数据集。}
}
