@inproceedings{li2026ppd,
  title         = {Not All Prefills Are Equal: {PPD} Disaggregation for Multi-turn {LLM} Serving},
  author        = {Li, Zongze and Liu, Jingyu and Xu, Zhen and Zhang, Yineng and Rabbani, Tahseen and Zhang, Ce},
  year          = {2026},
  booktitle     = {International Conference on Machine Learning (ICML)},
  eprint        = {2603.13358},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2603.13358},
  note          = {per-request choice between local append-prefill and remote prefill},
  note-zh       = {逐请求选择本地追加预填充还是远端预填充},
  tldr          = {PPD observes that prefilling only a later turn's new tokens on a decode node slows decoding far less than a full prefill, shows that no fixed routing rule meets all SLOs, and routes each later turn dynamically, cutting its time to first token by about 68 percent.},
  tldr-zh       = {PPD 发现，在解码节点上只为后续轮次的新词元做预填充，对解码的拖慢远小于完整预填充；它证明没有一种固定路由规则能同时满足所有 SLO，于是逐轮动态路由，使后续轮次的首词元时间缩短约 68\%。},
  further       = {no}
}

