@article{olah2020zoomin,
  title   = {Zoom In: An Introduction to Circuits},
  author  = {Olah, Chris and Cammarata, Nick and Schubert, Ludwig and Goh, Gabriel and Petrov, Michael and Carter, Shan},
  year    = {2020},
  journal = {Distill},
  doi     = {10.23915/distill.00024.001},
  url     = {https://distill.pub/2020/circuits/zoom-in/},
  tldr    = {This Distill article proposes that neural networks contain interpretable "circuits" of neurons encoding meaningful algorithms, and advances three hypotheses: features, circuits, and universality across models.},
  tldr-zh = {该 Distill 文章提出神经网络内部存在可理解的"电路"，由神经元连接构成有意义的算法，并提出特征、电路与跨模型通用性三个假说。}
}

