@inproceedings{leask2025canonical,
  title     = {Sparse Autoencoders Do Not Find Canonical Units of Analysis},
  author    = {Leask, Patrick and Bussmann, Bart and Pearce, Michael and Bloom, Joseph and Tigges, Curt and Al Moubayed, Noura and Sharkey, Lee and Nanda, Neel},
  year      = {2025},
