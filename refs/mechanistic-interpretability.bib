@article{paulo2025transcoders,
  title         = {Transcoders Beat Sparse Autoencoders for Interpretability},
  author        = {Paulo, Gon{\c{c}}alo and Shabalin, Stepan and Belrose, Nora},
  year          = {2025},
  journal       = {arXiv preprint arXiv:2501.18823},
  eprint        = {2501.18823},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2501.18823},
  tldr          = {On the tested models and automated metrics, transcoders offered a better reconstruction-interpretability trade-off than comparable MLP-output sparse autoencoders; the result is bounded to that comparison.},
