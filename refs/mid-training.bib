@article{chen2023position,
  title   = {Extending Context Window of Large Language Models via Positional Interpolation},
  author  = {Chen, Shouyuan and Wong, Sherman and Chen, Liangjian and Tian, Yuandong},
  year    = {2023},
  journal = {arXiv preprint arXiv:2306.15595},
  eprint  = {2306.15595},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2306.15595},
  note    = {RoPE context extension via interpolation rather than extrapolation},
  note-zh = {通过插值而非外推扩展 RoPE 上下文},
  tldr    = {Extends RoPE-based LLM context windows by linearly down-scaling position indices, avoiding unstable extrapolation and preserving original-window quality after limited fine-tuning.},
  tldr-zh = {通过线性缩放位置索引扩展基于 RoPE 的大语言模型上下文窗口，避免不稳定外推，并在少量微调后保留原窗口质量。}
}

@article{peng2023yarn,
  title   = {YaRN: Efficient Context Window Extension of Large Language Models},
  author  = {Peng, Bowen and Quesnelle, Jeffrey and Fan, Honglu and Shippole, Enrico},
  year    = {2023},
  journal = {arXiv preprint arXiv:2309.00071},
  eprint  = {2309.00071},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2309.00071},
  note    = {efficient RoPE context extension},
  note-zh = {高效 RoPE 上下文扩展},
  tldr    = {YaRN extends RoPE-based LLaMA context windows using far fewer tokens and training steps than previous approaches, demonstrating extrapolation beyond the fine-tuning length.},
