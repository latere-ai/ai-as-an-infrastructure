@article{bai2022constitutional,
  title   = {Constitutional AI: Harmlessness from AI Feedback},
  author  = {Bai, Yuntao and Kadavath, Saurav and Kundu, Sandipan and Askell, Amanda and Kernion, Jackson and Jones, Andy and Chen, Anna and Goldie, Anna and Mirhoseini, Azalia and McKinnon, Cameron and Chen, Carol and Olsson, Catherine and Olah, Christopher and Hernandez, Danny and Drain, Dawn and Ganguli, Deep and Li, Dustin and Tran-Johnson, Eli and Perez, Ethan and others},
  year    = {2022},
  journal = {arXiv preprint arXiv:2212.08073},
  eprint  = {2212.08073},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2212.08073},
  tldr    = {Constitutional AI uses written principles for model self-critique and revision, then uses AI comparisons to train a preference model for reinforcement learning without human harmlessness labels.},
  tldr-zh = {Constitutional AI 以成文原则引导模型自我批判与修订，再用 AI 比较训练用于强化学习的偏好模型，而不依赖人工无害性标签。}
}

