}

@inproceedings{wen2025cotpass,
  title   = {Reinforcement Learning with Verifiable Rewards Implicitly Incentivizes Correct Reasoning in Base LLMs},
  author  = {Wen, Xumeng and Liu, Zihan and Zheng, Shun and Ye, Shengyu and Wu, Zhirong and Wang, Yang and Xu, Zhijian and Liang, Xiao and Li, Junjie and Miao, Ziming and Bian, Jiang and Yang, Mao},
  year    = {2026},
  booktitle = {International Conference on Learning Representations},
  eprint  = {2506.14245},
  archivePrefix = {arXiv},
  url     = {https://openreview.net/forum?id=jGbRWwIidy},
  note    = {introduces CoT-Pass@K for the RLVR capability-boundary debate},
  tldr    = {This paper argues that ordinary Pass@K can credit correct answers with flawed reasoning and proposes CoT-Pass@K, requiring both reasoning path and final answer to be correct.},
  tldr-zh = {本文指出普通 Pass@K 可能把错误推理但答案正确的样本计为成功，并提出 CoT-Pass@K，要求推理路径与最终答案同时正确。}
}

@article{gunjal2025rubrics,
  title   = {Rubrics as Rewards: Reinforcement Learning Beyond Verifiable Domains},
  author  = {Gunjal, Anisha and Wang, Anthony and Lau, Elaine and Nath, Vaskar and He, Yunzhong and Liu, Bing and Hendryx, Sean},
  year    = {2025},
  journal = {arXiv preprint arXiv:2507.17746},
  eprint  = {2507.17746},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2507.17746},
  note    = {rubric-based rewards extend RLVR-style training into non-verifiable domains},
  tldr    = {Rubrics as Rewards decomposes open-ended judgments into per-criterion, checklist-style rubrics graded by a model and used as the reward for on-policy RL, outperforming LLM-as-judge Likert baselines on HealthBench and GPQA-Diamond.},
  tldr-zh = {Rubrics as Rewards 把开放式判断拆成逐条清单式评分准则，由模型逐条打分并作为在线强化学习的奖励，在 HealthBench 与 GPQA-Diamond 上优于模型作为评判者的 Likert 基线。}
}

@inproceedings{shao2025spurious,
  title   = {Spurious Rewards: Rethinking Training Signals in RLVR},
  author  = {Shao, Rulin and Li, Shuyue Stella and Xin, Rui and Geng, Scott and Wang, Yiping and Oh, Sewoong and Du, Simon Shaolei and Lambert, Nathan and Min, Sewon and Krishna, Ranjay and Tsvetkov, Yulia and Hajishirzi, Hannaneh and Koh, Pang Wei and Zettlemoyer, Luke},
  year    = {2026},
  booktitle = {Proceedings of the 43rd International Conference on Machine Learning},
  series  = {Proceedings of Machine Learning Research},
  volume  = {306},
  eprint  = {2506.10947},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.10947},
  note    = {spurious rewards expose model-dependent amplification in RLVR},
  further = {no},
  tldr    = {Spurious Rewards finds that random or incorrect rewards recover much of the ground-truth RLVR gain on Qwen2.5-Math-7B, while often failing on Llama and OLMo models, making the effect strongly base-model dependent.},
  tldr-zh = {Spurious Rewards 发现，随机或错误奖励在 Qwen2.5-Math-7B 上能恢复大部分真实奖励的 RLVR 增益，却常在 Llama 与 OLMo 模型上失效，说明该效应高度依赖底座模型。}
}

@inproceedings{shan2026rubrics,
  title   = {A Survey on Rubric-Guided Reinforcement Learning for Language Models},
  author  = {Shan, Zifei and Shao, Fangning},
  year    = {2026},
  booktitle = {Findings of the Association for Computational Linguistics: EMNLP 2026},
  eprint  = {2608.27505},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2608.27505},
  note    = {survey of rubric rewards and their open problems},
  note-zh = {评分准则奖励及其未解决问题的综述},
  further = {no},
  tldr    = {This survey treats constitutions as priors over evaluation criteria and rubrics as their per-prompt instances, organizes rubric-guided RL along that axis, and names granularity trade-offs, semantic drift, and linguistic reward hacking as open problems.},
  tldr-zh = {这篇综述把宪法视为评价标准的先验、把评分准则视为针对具体提示的实例，据此梳理评分准则强化学习，并把粒度取舍、语义漂移与利用措辞的奖励投机列为未解决问题。}
}

@article{damani2025rlcr,
  title   = {Beyond Binary Rewards: Training {LMs} to Reason About Their Uncertainty},
  author  = {Damani, Mehul and Puri, Isha and Slocum, Stewart and Shenfeld, Idan and Choshen, Leshem and Kim, Yoon and Andreas, Jacob},
  year    = {2025},
  journal = {arXiv preprint arXiv:2507.16806},
  eprint  = {2507.16806},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2507.16806},
  note    = {RLCR: a Brier-score term added to the correctness reward},
  note-zh = {RLCR：在正确性奖励上加入 Brier 分数项},
  further = {no},
  tldr    = {RLCR trains reasoning models to state a confidence with each answer and rewards correctness minus the Brier score, proves that any bounded proper scoring rule makes the optimum both accurate and calibrated, and reports that ordinary binary-reward RL hurts calibration while RLCR improves it.},
  tldr-zh = {RLCR 训练推理模型在每个答案后报出置信度，奖励为正确性减去 Brier 分数；作者证明任何有界的适当评分规则都能让最优解既准确又校准，并报告普通二元奖励强化学习会损害校准，而 RLCR 能改善校准。}
}

@article{yaldiz2026calibration,
  title   = {Balancing Classification and Calibration Performance in Decision-Making {LLMs} via Calibration Aware Reinforcement Learning},
  author  = {Yaldiz, Duygu Nur and Spiliopoulou, Evangelia and Qi, Zheng and Varia, Siddharth and Doss, Srikanth and Pappas, Nikolaos},
  year    = {2026},
  journal = {arXiv preprint arXiv:2601.13284},
  eprint  = {2601.13284},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2601.13284},
  note    = {RLVR overconfidence on decision tasks and a calibration-aware fix},
  note-zh = {决策任务上 RLVR 的过度自信，以及考虑校准的修正方法},
  further = {no},
  tldr    = {This study compares SFT and RLVR on decision-making tasks, finds that RLVR improves accuracy but yields extremely overconfident models because decision tokens carry no confidence information, and proposes a calibration-aware RL objective that keeps RLVR accuracy while reducing expected calibration error by up to 9 points.},
  tldr-zh = {这项研究在决策任务上比较 SFT 与 RLVR，发现 RLVR 提高准确率却让模型极度过度自信，原因是决策词元不携带置信信息；作者提出考虑校准的强化学习目标，在保持 RLVR 准确率的同时把期望校准误差最多降低 9 个点。}
}

@misc{almeida2026jev,
  title   = {Introducing System One Models \& Jev},
  author  = {Almeida, Diogo},
  year    = {2026},
  howpublished = {TypeSafe AI blog, 15 September 2026},
  url     = {https://typesafe.ai/blog/introducing-system-one-models-and-jev},
  note    = {vendor announcement of RLCD, Reinforcement Learning for Calibrated Decisions},
  note-zh = {厂商对 RLCD（Reinforcement Learning for Calibrated Decisions）的发布公告},
  further = {no},
  tldr    = {TypeSafe AI announces Jev, a model that returns typed decisions with probabilities instead of text, trained with a method it names Reinforcement Learning for Calibrated Decisions; the post gives no paper, reward function, or calibration figure, and its workflow evaluations use the average of GPT-6 Astra and Fable 5.1 answers as the reference.},
  tldr-zh = {TypeSafe AI 发布 Jev，这个模型不输出文本，而是返回附带概率的带类型决策，训练方法被命名为 Reinforcement Learning for Calibrated Decisions；文章没有给出论文、奖励函数或校准数据，其工作流评测以 GPT-6 Astra 与 Fable 5.1 答案的平均为参考。}
}

@article{yang2023rlcd,
  title   = {{RLCD}: Reinforcement Learning from Contrastive Distillation for Language Model Alignment},
  author  = {Yang, Kevin and Klein, Dan and Celikyilmaz, Asli and Peng, Nanyun and Tian, Yuandong},
  year    = {2023},
  journal = {arXiv preprint arXiv:2307.12950},
  eprint  = {2307.12950},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2307.12950},
  note    = {the earlier, unrelated RLCD: preference pairs from contrasting prompts},
  note-zh = {更早且无关的 RLCD：用相反提示构造偏好对},
  further = {no},
  tldr    = {RLCD builds preference pairs from two outputs generated under a positive prompt that encourages following a principle and a negative prompt that encourages violating it, trains a preference model on those pairs, and uses it as the reward for RL without human labels.},
  tldr-zh = {RLCD 用两条输出构造偏好对，一条在鼓励遵循原则的正向提示下生成，另一条在鼓励违背原则的反向提示下生成；再用这些偏好对训练偏好模型，并在没有人工标注的情况下把它作为强化学习奖励。}
}
