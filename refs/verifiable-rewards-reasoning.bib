@article{cobbe2021verifiers,
  title   = {Training Verifiers to Solve Math Word Problems},
  author  = {Cobbe, Karl and Kosaraju, Vineet and Bavarian, Mohammad and Chen, Mark and Jun, Heewoo and Kaiser, Lukasz and Plappert, Matthias and Tworek, Jerry and Hilton, Jacob and Nakano, Reiichiro and Hesse, Christopher and Schulman, John},
  year    = {2021},
  journal = {arXiv preprint arXiv:2110.14168},
  eprint  = {2110.14168},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2110.14168},
  note    = {best-of-N reranking with a trained verifier},
  tldr    = {Training Verifiers introduces GSM8K and shows that sampling many solutions then selecting with a verifier can outperform directly fine-tuning the generator on math word problems.},
  tldr-zh = {Training Verifiers 提出 GSM8K，并展示在数学文字题上采样多个解法再用验证器选择，能胜过只直接微调生成器。}
}

@article{shao2024deepseekmath,
  title   = {DeepSeekMath: Pushing the Limits of Mathematical Reasoning in Open Language Models},
  author  = {Shao, Zhihong and Wang, Peiyi and Zhu, Qihao and Xu, Runxin and Song, Junxiao and Bi, Xiao and Zhang, Haowei and Zhang, Mingchuan and Li, Y. K. and Wu, Y. and Guo, Daya},
  year    = {2024},
  journal = {arXiv preprint arXiv:2402.03300},
  eprint  = {2402.03300},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2402.03300},
  note    = {introduces GRPO},
  tldr    = {DeepSeekMath combines a curated 120B-token math corpus with GRPO, a PPO variant that removes the critic and normalizes rewards within sampled groups.},
  tldr-zh = {DeepSeekMath 结合 1200 亿词元数学语料与 GRPO，后者是去掉评论家、在采样组内归一化奖励的 PPO 变体。}
}

@article{guo2025deepseek,
  author    = {Guo, Daya and Yang, Dejian and Zhang, Haowei and Song, Junxiao and Wang, Peiyi and Zhu, Qihao and Xu, Runxin and Zhang, Ruoyu and Ma, Shirong and Bi, Xiao and others},
  title     = {DeepSeek-R1 incentivizes reasoning in LLMs through reinforcement learning},
  journal   = {Nature},
  volume    = {645},
  pages     = {633--638},
  year      = {2025},
  eprint    = {2501.12948},
  archivePrefix = {arXiv},
  url       = {https://www.nature.com/articles/s41586-025-09422-z},
  note      = {peer-reviewed version of arXiv:2501.12948, published 17 September 2025; DOI 10.1038/s41586-025-09422-z},
  tldr      = {DeepSeek-R1 shows that large-scale RL with verifiable rewards can elicit long reasoning behavior, with R1-Zero using RL without supervised cold start and R1 adding multi-stage training for readability and stability.},
  tldr-zh   = {DeepSeek-R1 展示了大规模可验证奖励强化学习能引出长推理行为；R1-Zero 不用监督冷启动直接 RL，R1 则加入多阶段训练以改善可读性和稳定性。}
}

@article{lightman2023lets,
  title   = {Let's Verify Step by Step},
  author  = {Lightman, Hunter and Kosaraju, Vineet and Burda, Yura and Edwards, Harri and Baker, Bowen and Lee, Teddy and Leike, Jan and Schulman, John and Sutskever, Ilya and Cobbe, Karl},
  year    = {2023},
  journal = {arXiv preprint arXiv:2305.20050},
  eprint  = {2305.20050},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.20050},
  note    = {process reward models / PRMs},
  tldr    = {Let's Verify Step by Step compares outcome and process supervision for math reasoning and releases PRM800K, about 800,000 step-level labels.},
