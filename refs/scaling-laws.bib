  number  = {240},
  pages   = {1--113},
  eprint  = {2204.02311},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2204.02311},
  note    = {z-loss, stability at scale},
  note-zh = {z-loss, 大规模稳定性},
  tldr    = {Reports the 540B-parameter PaLM model and its large-scale training recipe, including output z-loss and checkpoint recovery from irregular loss spikes.},
  tldr-zh = {用 Pathways 系统在 6144 块 TPU v4 上训练 540B 参数的稠密 Transformer（PaLM），以研究规模如何在众多任务上提升少样本性能。}
}

@article{wortsman2023small,
  title   = {Small-Scale Proxies for Large-Scale Transformer Training Instabilities},
  author  = {Wortsman, Mitchell and Liu, Peter J. and Xiao, Lechao and Everett, Katie and Alemi, Alex and Adlam, Ben and Co-Reyes, John D. and Gur, Izzeddin and Kumar, Abhishek and Novak, Roman and Pennington, Jeffrey and Sohl-Dickstein, Jascha and Xu, Kelvin and Lee, Jaehoon and Gilmer, Justin and Kornblith, Simon},
  year    = {2023},
  journal = {arXiv preprint arXiv:2309.14322},
  eprint  = {2309.14322},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2309.14322},
  further = {no},
  tldr    = {Reproduces attention-logit and output-logit instabilities in small proxy models and evaluates mitigations that had been used at large scale.},
  tldr-zh = {在小型代理模型中复现注意力 logit 与输出 logit 不稳定，并评估此前用于大规模训练的缓解方法。}
}

@misc{jordan2024muon,
  title        = {Muon: An Optimizer for Hidden Layers in Neural Networks},
  author       = {Jordan, Keller and Jin, Yuchen and Boza, Vlado and You, Jiacheng and Cesista, Franz and Newhouse, Laker and Bernstein, Jeremy},
  year         = {2024},
  howpublished = {\url{https://kellerjordan.github.io/posts/muon/}},
  url          = {https://kellerjordan.github.io/posts/muon/},
  tldr         = {Introduces Muon, an optimizer for hidden layers that orthogonalizes momentum-based updates, setting training-speed records on NanoGPT and CIFAR-10.},
  tldr-zh      = {提出 Muon，一种通过正交化基于动量的更新来优化隐藏层的优化器，在 NanoGPT 与 CIFAR-10 上创下训练速度纪录。}
}

@article{liu2025muon,
  title   = {Muon is Scalable for LLM Training},
  author  = {Liu, Jingyuan and Su, Jianlin and Yao, Xingcheng and Jiang, Zhejun and Lai, Guokun and Du, Yulun and Qin, Yidao and Xu, Weixin and Lu, Enzhe and Yan, Junjie and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2502.16982},
  eprint  = {2502.16982},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2502.16982},
  tldr    = {Shows the Muon optimizer scales to large LLMs by adding weight decay and tuning the per-parameter update scale, reaching about 2x the compute efficiency of AdamW; trains Moonlight, a 16B MoE model, on 5.7T tokens.},
  tldr-zh = {通过加入权重衰减并调整每参数的更新尺度，使 Muon 优化器可扩展到大型 LLM，达到约为 AdamW 两倍的算力效率；并用 5.7T 词元训练出 16B 的 MoE 模型 Moonlight。}
}

@article{kimiteam2025k2,
  title   = {Kimi K2: Open Agentic Intelligence},
  author  = {{Kimi Team}},
  year    = {2025},
  journal = {arXiv preprint arXiv:2507.20534},
  eprint  = {2507.20534},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2507.20534},
  note    = {Muon (as MuonClip) at trillion-parameter scale},
  note-zh = {Muon（MuonClip 形态）用到万亿参数规模},
  tldr    = {Kimi K2 is a 1T-total, 32B-active MoE model pre-trained on 15.5T tokens with MuonClip, a Muon variant whose QK-clip removes attention-logit blowups, with zero loss spikes over the run.},
  tldr-zh = {Kimi K2 是总参数 1T、激活 32B 的 MoE 模型，用 MuonClip（在 Muon 上加 QK-clip 抑制注意力 logit 爆炸）在 15.5T 词元上预训练，全程没有损失尖峰。}
}

@article{deepseek2024deepseekv3,
  title   = {DeepSeek-V3 Technical Report},
  author  = {{DeepSeek-AI}},
  year    = {2024},
  journal = {arXiv preprint arXiv:2412.19437},
  eprint  = {2412.19437},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2412.19437},
  note    = {14.8T-token training stability; no irrecoverable spike or rollback reported},
  note-zh = {14.8 万亿词元训练稳定性；未报告不可恢复尖峰或回滚},
  tldr    = {Reports DeepSeek-V3, a 671B-parameter Mixture-of-Experts model with 37B active per token, trained on 14.8T tokens with auxiliary-loss-free load balancing and multi-token prediction, rivaling closed models at low cost.},
  tldr-zh = {介绍 DeepSeek-V3，一个 671B 参数、每词元激活 37B 的混合专家模型，用 14.8T 词元训练，采用无辅助损失的负载均衡与多词元预测，以低成本比肩闭源模型。}
}

@inproceedings{rosenfeld2020constructive,
  title     = {A Constructive Prediction of the Generalization Error Across Scales},
  author    = {Rosenfeld, Jonathan S. and Rosenfeld, Amir and Belinkov, Yonatan and Shavit, Nir},
  year      = {2020},
  booktitle = {International Conference on Learning Representations (ICLR)},
  eprint    = {1909.12673},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/1909.12673},
  tldr      = {Proposes the parametric envelope form of the generalization error as a power law in model size and data size plus an irreducible floor, fit across vision and language, predating its language-model specialization.},
  tldr-zh  = {提出泛化误差的参数化包络形式，即随模型规模与数据规模的幂律再加一个不可约下界，在视觉与语言上拟合，早于其在语言模型上的专门化。}
}

@article{besiroglu2024replication,
  title   = {Chinchilla Scaling: A Replication Attempt},
  author  = {Besiroglu, Tamay and Erdil, Ege and Barnett, Matthew and You, Josh},
  year    = {2024},
  journal = {arXiv preprint arXiv:2404.10102},
  eprint  = {2404.10102},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2404.10102},
  tldr    = {Replicates the Chinchilla parametric fit and finds its third estimate inconsistent with the paper's own first two, with confidence intervals so narrow they would require hundreds of thousands of runs rather than the few hundred actually performed.},
  tldr-zh = {复现 Chinchilla 的参数化拟合，发现其第三种估计与论文自身前两种方法不一致，且其置信区间窄到需要数十万次实验才能成立，而实际只跑了数百次。}
}

@article{pearce2024reconciling,
  title   = {Reconciling Kaplan and Chinchilla Scaling Laws},
  author  = {Pearce, Tim and Song, Jinyeop},
  year    = {2024},
  journal = {Transactions on Machine Learning Research},
  eprint  = {2406.12907},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2406.12907},
  tldr    = {Attributes the Kaplan-Chinchilla disagreement largely to Kaplan counting non-embedding rather than total parameters at small scale; once embeddings are included and scale grows, the optimal exponent converges to the Chinchilla estimate.},
  tldr-zh = {将 Kaplan 与 Chinchilla 的分歧主要归因于 Kaplan 在小规模下计入的是非嵌入参数而非总参数；一旦计入嵌入参数并放大规模，最优指数便收敛到 Chinchilla 的估计。}
}

@article{lovelace2026prescriptive,
  title   = {Prescriptive Scaling Laws for Data Constrained Training},
  author  = {Lovelace, Justin and Belardi, Christian and Kundurthy, Srivatsa and Sudhakar, Shriya and Weinberger, Kilian Q.},
  year    = {2026},
  journal = {arXiv preprint arXiv:2605.01640},
  eprint  = {2605.01640},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2605.01640},
  tldr    = {In experiments up to 1B parameters and 16 epochs, adds an explicit repetition penalty and finds regimes where more capacity beats further repetition; stronger weight decay reduces the penalty but pays a single-epoch cost.},
  tldr-zh = {在数据受限的扩展律中加入一个显式的过拟合惩罚项，发现更大的模型在重复数据上过拟合得更快，而强权重衰减能大幅降低该惩罚。}
}

@article{sharma2020neural,
  title   = {Scaling Laws from the Data Manifold Dimension},
  author  = {Sharma, Utkarsh and Kaplan, Jared},
  year    = {2022},
  journal = {Journal of Machine Learning Research},
  volume  = {23},
  number  = {9},
  pages   = {1--34},
  eprint  = {2004.10802},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2004.10802},
  tldr    = {Derives the scaling exponent from the intrinsic dimension of the data manifold, predicting that loss falls as a power law whose rate is set by how many dimensions the data effectively occupies.},
  tldr-zh = {从数据流形的内蕴维数推导出扩展指数，预言损失随幂律下降，其速率由数据实际占据的维数决定。}
}

@inproceedings{michaud2023quantization,
  title     = {The Quantization Model of Neural Scaling},
  author    = {Michaud, Eric J. and Liu, Ziming and Girit, Uzay and Tegmark, Max},
  year      = {2023},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  volume    = {36},
  pages     = {28699--28722},
  eprint    = {2303.13506},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2303.13506},
  tldr      = {Proposes a discrete-skill hypothesis for neural scaling, validates it on synthetic tasks, and presents tentative evidence that language-model scaling may show related behavior.},
  tldr-zh  = {提出技能是离散的量子，按使用频率递减的顺序被学到；当这些频率服从幂律时，按序学习便产生平滑的幂律损失，并把涌现重新解释为量子逐个开启。}
}

@article{brill2024rooted,
  title   = {Neural Scaling Laws Rooted in the Data Distribution},
  author  = {Brill, Ari},
  year    = {2024},
  journal = {arXiv preprint arXiv:2412.07942},
  eprint  = {2412.07942},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2412.07942},
  tldr    = {Uses synthetic percolation-based regression data to explore how discrete-skill and data-manifold scaling regimes can arise on opposite sides of a threshold.},
  tldr-zh = {用自然数据上的渗流理论从第一性原理同时推导出扩展的离散量子图景与数据流形图景，将两种解释统一为渗流阈值两侧的不同区制。}
}
