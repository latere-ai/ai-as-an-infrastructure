@article{zhang2024genrm,
  title   = {Generative Verifiers: Reward Modeling as Next-Token Prediction},
  author  = {Zhang, Lunjun and Hosseini, Arian and Bansal, Hritik and Kazemi, Mehran and Kumar, Aviral and Agarwal, Rishabh},
  year    = {2024},
  journal = {arXiv preprint arXiv:2408.15240},
  eprint  = {2408.15240},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2408.15240},
  tldr    = {GenRM trains LLM verifiers with next-token prediction rather than discriminative classification, enabling verifier chain-of-thought and test-time voting for Best-of-N selection.},
  tldr-zh = {GenRM 用下一词元预测训练大语言模型验证器，而非判别式分类，使验证器能写思维链并通过测试时投票改善 Best-of-N 选择。}
}

@article{zhang2025prmlessons,
  title   = {The Lessons of Developing Process Reward Models in Mathematical Reasoning},
  author  = {Zhang, Zhenru and Zheng, Chujie and Wu, Yangzhen and Zhang, Beichen and Lin, Runji and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2501.07301},
  eprint  = {2501.07301},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2501.07301},
  note    = {Monte Carlo step labels versus consensus filtering; releases Qwen2.5-Math-PRM and ProcessBench},
  tldr    = {Monte-Carlo-estimated step labels yield weaker PRMs than LLM-as-judge and human annotation; a consensus filter that keeps only steps where both agree produces the stronger Qwen2.5-Math-PRM, evaluated on the released ProcessBench.},
  tldr-zh = {用蒙特卡洛估计合成的步骤标签训练出的 PRM，弱于 LLM 评判与人工标注；只保留两者一致步骤的共识过滤造就了更强的 Qwen2.5-Math-PRM，并在同时发布的 ProcessBench 上评估。}
}

@article{khalifa2025thinkprm,
  title   = {Process Reward Models That Think},
  author  = {Khalifa, Muhammad and Agarwal, Rishabh and Logeswaran, Lajanugen and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.16828},
  eprint  = {2504.16828},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.16828},
  note    = {ThinkPRM; generative step-level verification with about 1\% of PRM800K labels},
  tldr    = {ThinkPRM is a generative PRM that verbalizes step-by-step verification as a chain of thought, outperforming discriminative PRMs and LLM-as-judge while training on roughly 1\% of the process labels in PRM800K.},
  tldr-zh = {ThinkPRM 是一种生成式 PRM，把逐步验证写成思维链，仅用 PRM800K 约 1\% 的过程标签即可超过判别式 PRM 与 LLM 评判。}
}
