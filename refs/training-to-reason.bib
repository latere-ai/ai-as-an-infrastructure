@article{minimax2025m1,
  title   = {{MiniMax-M1}: Scaling Test-Time Compute Efficiently with Lightning Attention},
  author  = {{MiniMax}},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.13585},
