@article{zhang2025interplay,
  title   = {On the Interplay of Pre-Training, Mid-Training, and {RL} on Reasoning Language Models},
  author  = {Zhang, Charlie and Neubig, Graham and Yue, Xiang},
  year    = {2025},
  journal = {arXiv preprint arXiv:2512.07783},
  eprint  = {2512.07783},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2512.07783},
  note    = {controlled study of when RL raises pass@128},
  note-zh = {用受控实验研究强化学习何时提高 pass@128},
  further = {no},
  tldr    = {In a controlled framework of synthetic reasoning tasks, RL raises pass@128 only when pretraining leaves headroom and the RL data target the model's edge of competence, and mid-training outperforms RL alone at fixed compute.},
  tldr-zh = {在基于合成推理任务的受控框架中，只有预训练留有余地、且强化学习数据对准模型的能力边缘时，强化学习才会提高 pass@128；在固定算力下，中期训练的效果优于只做强化学习。}
}

