@article{gunjal2025rubrics,
  title   = {Rubrics as Rewards: Reinforcement Learning Beyond Verifiable Domains},
  author  = {Gunjal, Anisha and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2507.17746},
  eprint  = {2507.17746},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2507.17746},
  note    = {rubric-based rewards extend RLVR-style training into non-verifiable domains},
  further = {no},
  tldr    = {RaR (Rubrics as Rewards) extends RLVR to open-ended domains by using instance-specific, checklist-style rubrics as structured reward signals for on-policy GRPO training, outperforming LLM-as-judge Likert baselines on HealthBench and GPQA-Diamond.},
  tldr-zh = {RaR（Rubrics as Rewards）通过将实例级评分准则作为结构化奖励信号用于 GRPO 的在线强化学习训练，将可验证奖励的强化学习（RLVR）扩展至开放域推理，在 HealthBench 和 GPQA-Diamond 上优于模型作为评判者的 Likert 基线。}
}

@article{shao2025spurious,
  title   = {Spurious Rewards: Rethinking Training Signals in RLVR},
  author  = {Shao, Rulin and Li, Shuyue Stella and Xin, Rui and Geng, Scott and Wang, Yiping and Oh, Sewoong and Du, Simon Shaolei and Lambert, Nathan and Min, Sewon and Krishna, Ranjay and Tsvetkov, Yulia and Hajishirzi, Hannaneh and Koh, Pang Wei and Zettlemoyer, Luke},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.10947},
  eprint  = {2506.10947},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.10947},
  note    = {random and incorrect rewards recover most of the RLVR gain on Qwen2.5-Math},
  further = {no},
  tldr    = {RLVR with random or incorrect rewards recovers most of the ground-truth gain on Qwen2.5-Math-7B (+21.4 vs +29.1 points on MATH-500) yet fails on Llama and OLMo, suggesting GRPO amplifies pretrained behaviors rather than teaching new reasoning.},
  tldr-zh = {在 Qwen2.5-Math-7B 上，用随机甚至错误的奖励做 RLVR 也能取得接近真值奖励的增益（MATH-500 上 +21.4 对 +29.1 分），而同样的伪奖励在 Llama 与 OLMo 上无效，说明 GRPO 更多是在放大预训练已有的行为，而非教出新推理。}
}

