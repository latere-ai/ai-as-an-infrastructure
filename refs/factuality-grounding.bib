  author  = {Gao, Tianyu and Yen, Howard and Yu, Jiatong and Chen, Danqi},
  year    = {2023},
  journal = {arXiv preprint arXiv:2305.14627},
  eprint  = {2305.14627},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.14627},
  note    = {citation quality as a measurable dimension},
  note-zh = {把引用质量变成可测维度},
  tldr    = {ALCE evaluates answer correctness, fluency, and citation quality for retrieval-backed generation, showing that even strong models often lack complete citation support.},
