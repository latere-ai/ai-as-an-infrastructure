  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2024.eacl-demo.16},
  url       = {https://aclanthology.org/2024.eacl-demo.16/},
  tldr      = {RAGAS proposes model-mediated, reference-free proxies for faithfulness, answer relevance, and context relevance; its archival paper does not define context recall.},
  tldr-zh   = {RAGAS 提出由模型介入、无需人工参考答案的忠实度、回答相关性与上下文相关性代理指标；其正式论文没有定义上下文召回。}
}

@inproceedings{gao2023alce,
  title     = {Enabling Large Language Models to Generate Text with Citations},
  author    = {Gao, Tianyu and Yen, Howard and Yu, Jiatong and Chen, Danqi},
  year      = {2023},
  booktitle = {Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing},
  pages     = {6465--6488},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2023.emnlp-main.398},
  url       = {https://aclanthology.org/2023.emnlp-main.398/},
  tldr      = {ALCE evaluates retrieval-backed answers along fluency, task-specific correctness, citation recall, and citation precision, with automatic citation judgments mediated by an NLI model.},
  tldr-zh   = {ALCE 从流畅度、任务特定正确性、引用召回与引用精确率评测检索支持的回答，其自动引用判断由自然语言推断模型介入。}
}

@article{jacovi2025facts,
  title         = {The {FACTS} Grounding Leaderboard: Benchmarking {LLMs}' Ability to Ground Responses to Long-Form Input},
  author        = {Jacovi, Alon and Wang, Andrew and Alberti, Chris and Tao, Connie and Lipovetz, Jon and Olszewska, Kate and Haas, Lukas and Liu, Michelle and Keating, Nate and Bloniarz, Adam and Saroufim, Carl and Fry, Corey and Marcus, Dror and Kukliansky, Doron and Tomar, Gaurav Singh and Swirhun, James and Xing, Jinwei and Wang, Lily and Gurumurthy, Madhu and Aaron, Michael and Ambar, Moran and Fellinger, Rachana and Wang, Rui and Zhang, Zizhao and Goldshtein, Sasha and Das, Dipanjan},
