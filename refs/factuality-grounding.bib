  note    = {correct, incorrect, or not attempted},
  note-zh = {正确、错误或不作答},
  tldr    = {SimpleQA evaluates short fact-seeking questions with single indisputable answers and grades responses as correct, incorrect, or not attempted to measure whether models know what they know.},
