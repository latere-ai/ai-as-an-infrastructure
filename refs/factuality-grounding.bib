}

@techreport{wei2024simpleqa,
  title       = {Measuring Short-Form Factuality in Large Language Models},
  author      = {Wei, Jason and Nguyen, Karina and Chung, Hyung Won and Jiao, Yunxin Joy and Papay, Spencer and Glaese, Amelia and Schulman, John and Fedus, William},
  year        = {2024},
  institution = {OpenAI},
  url         = {https://cdn.openai.com/papers/simpleqa.pdf},
  tldr        = {SimpleQA uses 4,326 adversarially collected short questions intended to have one accepted answer and grades responses as correct, incorrect, or not attempted.},
  tldr-zh     = {SimpleQA 使用 4,326 个对抗式收集、预期只有一个公认答案的短问题，并把回答标为正确、错误或不作答。}
}

@article{haas2025simpleqaverified,
  title         = {{SimpleQA Verified}: A Reliable Factuality Benchmark to Measure Parametric Knowledge},
  author        = {Haas, Lukas and Yona, Gal and D'Antonio, Giovanni and Goldshtein, Sasha and Das, Dipanjan},
  year          = {2025},
  journal       = {arXiv preprint arXiv:2509.07968},
  eprint        = {2509.07968},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2509.07968},
  further       = {no},
  tldr          = {SimpleQA Verified creates a filtered 1,000-question derivative after auditing labels, duplicates, and topic balance; it does not alter the original benchmark in place.},
  tldr-zh       = {SimpleQA Verified 在审核标签、重复项和主题平衡后建立一个筛选出的 1,000 题衍生集，并未原地修改原基准。}
}

@article{chow1970reject,
  title   = {On Optimum Recognition Error and Reject Tradeoff},
  author  = {Chow, C. K.},
  year    = {1970},
  journal = {IEEE Transactions on Information Theory},
  volume  = {16},
  number  = {1},
  pages   = {41--46},
