@inproceedings{lin2021truthfulqa,
  title     = {{TruthfulQA}: Measuring How Models Mimic Human Falsehoods},
  author    = {Lin, Stephanie and Hilton, Jacob and Evans, Owain},
  year      = {2022},
  booktitle = {Proceedings of the 60th Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)},
  pages     = {3214--3252},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2022.acl-long.229},
  url       = {https://aclanthology.org/2022.acl-long.229/},
  tldr      = {TruthfulQA tests 817 questions designed around false beliefs and misconceptions, showing that truthfulness on this adversarial population differs from imitation accuracy.},
  tldr-zh   = {TruthfulQA 用围绕错误信念和误解设计的 817 个问题进行测试，说明在这一对抗性题目群体上，真实性不同于模仿准确率。}
}

@article{rashkin2023attribution,
  title     = {Measuring Attribution in Natural Language Generation Models},
  author    = {Rashkin, Hannah and Nikolaev, Vitaly and Lamm, Matthew and Aroyo, Lora and Collins, Michael and Das, Dipanjan and Petrov, Slav and Tomar, Gaurav Singh and Turc, Iulia and Reitter, David},
  year      = {2023},
  journal   = {Computational Linguistics},
  volume    = {49},
  number    = {4},
  pages     = {777--840},
  publisher = {MIT Press},
  doi       = {10.1162/coli_a_00486},
  url       = {https://aclanthology.org/2023.cl-4.2/},
  tldr      = {The AIS framework defines attribution as support from independent identified sources under explicit annotation guidelines, while leaving source quality as a complementary judgment.},
  tldr-zh   = {AIS 框架把归因定义为在明确标注准则下由独立、可识别来源提供支持，同时把来源质量保留为另一项判断。}
}

@inproceedings{thorne2018fever,
  title     = {{FEVER}: a Large-scale Dataset for Fact Extraction and {VERification}},
  author    = {Thorne, James and Vlachos, Andreas and Christodoulopoulos, Christos and Mittal, Arpit},
  year      = {2018},
  booktitle = {Proceedings of the 2018 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, Volume 1 (Long Papers)},
  pages     = {809--819},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/N18-1074},
  url       = {https://aclanthology.org/N18-1074/},
  tldr      = {FEVER couples claims with evidence from a fixed Wikipedia snapshot and labels them Supported, Refuted, or NotEnoughInfo, keeping missing evidence distinct from falsehood.},
  tldr-zh   = {FEVER 把 claim 与固定维基百科快照中的证据配对，并标记为支持、反驳或证据不足，从而把缺少证据与错误区分开。}
}

@inproceedings{min2023factscore,
  title     = {{FActScore}: Fine-grained Atomic Evaluation of Factual Precision in Long Form Text Generation},
  author    = {Min, Sewon and Krishna, Kalpesh and Lyu, Xinxi and Lewis, Mike and Yih, Wen-tau and Koh, Pang Wei and Iyyer, Mohit and Zettlemoyer, Luke and Hajishirzi, Hannaneh},
  year      = {2023},
  booktitle = {Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing},
  pages     = {12076--12100},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2023.emnlp-main.741},
  url       = {https://aclanthology.org/2023.emnlp-main.741/},
  tldr      = {FActScore decomposes long-form generations into atomic facts and measures the percentage supported by a specified knowledge source, producing a factual-precision estimate rather than recall.},
  tldr-zh   = {FActScore 将长文本生成拆成原子事实，并测量其中被指定知识来源支持的比例；它估计的是事实精确率，而不是召回率。}
}

@inproceedings{wei2024longform,
  title     = {Long-form Factuality in Large Language Models},
  author    = {Wei, Jerry and Yang, Chengrun and Song, Xinying and Lu, Yifeng and Hu, Nathan and Huang, Jie and Tran, Dustin and Peng, Daiyi and Liu, Ruibo and Huang, Da and Du, Cosmo and Le, Quoc V.},
