  tldr-zh = {把文档 ACL 带进搜索索引的厂商参考文档：可过滤且不可返回的身份字段、基于字符串的安全过滤器与经 x-ms-query-source-authorization 传入 Entra 令牌的权限过滤器，以及权限变更须等元数据同步到索引后才生效这一规则。}
}

@misc{microsoft2026vectorfilters,
  author       = {{Microsoft}},
  title        = {Vector Query Filters in Azure AI Search},
  howpublished = {Microsoft Learn},
  year         = {2026},
  url          = {https://learn.microsoft.com/en-us/azure/search/vector-search-filters},
  note         = {prefilter, postfilter, measured QPS trade-off},
  note-zh      = {前置过滤、后置过滤与实测 QPS 权衡},
  further      = {no},
  tldr    = {Prefiltering applies the predicate during HNSW traversal and guarantees k results if they exist; postfiltering filters after traversal and can return fewer than k. Benchmarks put prefiltering roughly seven times slower at 1M vectors when the filter selects under 2\% of the corpus.},
  tldr-zh = {前置过滤在 HNSW 遍历中代入谓词，只要存在就能返回 k 条结果；后置过滤在遍历之后再过滤，返回条数可能不足 k。基准显示，在一百万条向量、过滤条件只选中语料不到 2\% 时，前置过滤约慢七倍。}
}

@misc{microsoft2026securityfilters,
  author       = {{Microsoft}},
  title        = {Security Filters for Trimming Results in Azure AI Search},
  howpublished = {Microsoft Learn},
  year         = {2026},
  url          = {https://learn.microsoft.com/en-us/azure/search/search-security-trimming-for-azure-search},
  note         = {Collection(Edm.String) identity field, filterable true, retrievable false},
  note-zh      = {Collection(Edm.String) 身份字段，filterable 为 true、retrievable 为 false},
  further      = {no},
  tldr    = {The security filter pattern: store principal identifiers in a Collection(Edm.String) field with filterable true and retrievable false, and trim results with search.in at query time. There is no authentication or authorization behind the principal, which is only a string in a filter expression.},
  tldr-zh = {安全过滤器模式：把主体标识符存进一个 Collection(Edm.String) 字段，filterable 设为 true、retrievable 设为 false，查询时用 search.in 裁剪结果。主体背后没有任何认证或授权，它只是过滤表达式里的一个字符串。}
}

@misc{microsoft2026aclenforcement,
  author       = {{Microsoft}},
  title        = {Query-Time ACL and RBAC Enforcement in Azure AI Search},
  howpublished = {Microsoft Learn},
  year         = {2026},
  url          = {https://learn.microsoft.com/en-us/azure/search/search-query-access-control-rbac-enforcement},
  note         = {2026-05-01-preview; internal security filter construction, group expansion through Microsoft Graph},
  note-zh      = {2026-05-01-preview；服务端内部构造安全过滤器，组成员经 Microsoft Graph 展开},
  further      = {no},
  tldr    = {Query-time enforcement in the 2026-05-01-preview REST API: the service builds security filters internally from the user, group and scope claims and appends them to any filter already on the query, resolves group membership through Microsoft Graph, and returns 5xx rather than a partially filtered result set if ACL evaluation fails.},
  tldr-zh = {2026-05-01-preview REST API 中的查询时判定：服务端根据用户、组与作用域声明在内部构造安全过滤器，并追加到查询已有的过滤条件上；组成员关系经 Microsoft Graph 解析；若 ACL 判定失败，返回 5xx，而不是给出一份被部分过滤的结果集。}
}
