@article{chen2023frugalgpt,
  title   = {{FrugalGPT}: How to Use Large Language Models While Reducing Cost and Improving Performance},
  author  = {Chen, Lingjiao and Zaharia, Matei and Zou, James},
  journal = {arXiv preprint arXiv:2305.05176},
  year    = {2023},
  url     = {https://arxiv.org/abs/2305.05176},
  note    = {Prompt adaptation, approximation, and cascades for measured cost-quality trade-offs},
  note-zh = {通过提示适配、近似和级联研究实测成本—质量权衡},
  tldr    = {FrugalGPT studies model cascades and other strategies for reducing API cost while measuring resulting task performance rather than assuming a cheaper route is equivalent.},
  tldr-zh = {FrugalGPT 研究模型级联等降低 API 成本的方法，同时测量任务表现，而不是假定较便宜的路由效果等价。}
}

@article{ong2024routellm,
  title   = {{RouteLLM}: Learning to Route LLMs with Preference Data},
  author  = {Ong, Isaac and Almahairi, Amjad and Wu, Vincent and Chiang, Wei-Lin and Wu, Tianhao and Gonzalez, Joseph E. and Kadous, M. Waleed and Stoica, Ion},
  journal = {arXiv preprint arXiv:2406.18665},
  year    = {2024},
  url     = {https://arxiv.org/abs/2406.18665},
  note    = {Learns routing policies between stronger and weaker models from preference data},
  note-zh = {利用偏好数据学习在较强与较弱模型之间选择的路由策略},
  tldr    = {RouteLLM evaluates learned routers as policies that trade model quality against cost, making clear that routing behavior must be measured rather than assumed.},
  tldr-zh = {RouteLLM 将学习得到的路由器作为质量与成本权衡策略进行评估，说明路由行为必须实测而不能预设。}
}
