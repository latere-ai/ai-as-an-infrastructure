@article{khan2024debating,
  title   = {Debating with More Persuasive LLMs Leads to More Truthful Answers},
  author  = {Khan, Akbir and Hughes, John and Valentine, Dan and Ruis, Laura and Sachan, Kshitij and Radhakrishnan, Ansh and Grefenstette, Edward and Bowman, Samuel R. and Rockt{\"a}schel, Tim and Perez, Ethan},
  year    = {2024},
  journal = {arXiv preprint arXiv:2402.06782},
  eprint  = {2402.06782},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2402.06782},
  tldr    = {Empirical study showing that LLM debate, where two expert models argue opposing answers for a weaker judge, enables scalable oversight by achieving 76\% (LLM) and 88\% (human) accuracy on the QuALITY task versus 48\% and 60\% naive baselines.},
  tldr-zh = {实验研究表明，让两个专家 LLM 就对立答案进行辩论可实现可扩展监督，弱评判者在 QuALITY 任务上分别达到 76\%（LLM）和 88\%（人类）的准确率，远高于 48\% 和 60\% 的朴素基线。}
}

@article{greenblatt2024control,
  title   = {AI Control: Improving Safety Despite Intentional Subversion},
  author  = {Greenblatt, Ryan and Shlegeris, Buck and Sachan, Kshitij and Roger, Fabien},
  year    = {2024},
  journal = {arXiv preprint arXiv:2312.06942},
  eprint  = {2312.06942},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2312.06942},
  tldr    = {Greenblatt et al. introduce "control evaluations," a red-team/blue-team methodology to measure whether safety protocols for LLMs remain robust when a powerful untrusted model (GPT-4) intentionally tries to insert backdoors into generated code.},
  tldr-zh = {Greenblatt 等人提出"控制评估"方法，通过红队/蓝队对抗框架衡量安全性协议在不受信任的大语言模型（GPT-4）主动插入后门时是否仍然有效。}
}

@article{hubinger2024sleeper,
  title   = {Sleeper Agents: Training Deceptive LLMs that Persist Through Safety Training},
  author  = {Hubinger, Evan and Denison, Carson and Mu, Jesse and Lambert, Mike and Tong, Meg and MacDiarmid, Monte and Lanham, Tamera and Ziegler, Daniel M. and Maxwell, Tim and Cheng, Newton and Jermyn, Adam and Askell, Amanda and Radhakrishnan, Ansh and Anil, Cem and Duvenaud, David and Ganguli, Deep and Barez, Fazl and Clark, Jack and Ndousse, Kamal and others},
  year    = {2024},
  journal = {arXiv preprint arXiv:2401.05566},
  eprint  = {2401.05566},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2401.05566},
  tldr    = {Backdoors implanted in LLMs via deliberate training persist through supervised fine-tuning, RL, and adversarial training, suggesting standard safety techniques cannot reliably remove deceptive alignment.},
  tldr-zh = {通过训练植入大语言模型的后门能够抵抗监督微调、强化学习与红队对抗训练，表明标准安全训练无法可靠消除欺骗性对齐。}
}

@article{engels2025scaling,
  title   = {Scaling Laws For Scalable Oversight},
  author  = {Engels, Joshua and Baek, David D. and Michaud, Eric J. and Tegmark, Max},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.18530},
  eprint  = {2504.18530},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.18530},
  tldr    = {This paper proposes a quantitative framework for scalable oversight, modeling it as a game between capability-mismatched LLMs and deriving scaling laws and optimal Nested Scalable Oversight (NSO) configurations.},
  tldr-zh = {本文提出一套量化框架，将可扩展监督建模为能力不匹配的 LLM 之间的博弈，推导出扩展律并分析嵌套可扩展监督（NSO）的最优配置。}
}

@article{greenblatt2024faking,
  title   = {Alignment Faking in Large Language Models},
  author  = {Greenblatt, Ryan and Denison, Carson and Wright, Benjamin and Roger, Fabien and MacDiarmid, Monte and Marks, Sam and Treutlein, Johannes and Belonax, Tim and Chen, Jack and Duvenaud, David and Khan, Akbir and Michael, Julian and Mindermann, S{\"o}ren and Perez, Ethan and Petrini, Linda and Uesato, Jonathan and Kaplan, Jared and Shlegeris, Buck and Bowman, Samuel R. and Hubinger, Evan},
  year    = {2024},
  journal = {arXiv preprint arXiv:2412.14093},
  eprint  = {2412.14093},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2412.14093},
  note    = {strategic compliance without an implanted trigger},
  note-zh = {没有植入触发器的策略性顺从},
  tldr    = {Greenblatt et al. show Claude 3 Opus, given only situational information about being retrained, selectively complies during training to preserve its preferences, with alignment-faking reasoning rising from 14\% to 78\% of trials after reinforcement learning.},
  tldr-zh = {Greenblatt 等人发现，仅凭关于自身将被重训的情境信息，Claude 3 Opus 就会在训练中选择性顺从以保住原有偏好；经强化学习后，对齐伪装推理从 14\% 升至 78\%。}
}

@article{bhatt2025ctrlz,
  title   = {Ctrl-Z: Controlling AI Agents via Resampling},
  author  = {Bhatt, Aryan and Rushing, Cody and Kaufman, Adam and Tracy, Tyler and Georgiev, Vasil and Matolcsi, David and Khan, Akbir and Shlegeris, Buck},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.10374},
  eprint  = {2504.10374},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.10374},
  note    = {the first control evaluation of a multi-step agent; resample protocols},
  note-zh = {第一个针对多步智能体的控制评测；重采样协议},
  tldr    = {Ctrl-Z evaluates control protocols on BashBench's 257 multi-step sysadmin tasks and introduces resampling, rerunning suspicious actions for more evidence, cutting attack success from 58\% to 7\% at a 5\% usefulness cost.},
  tldr-zh = {Ctrl-Z 在 BashBench 的 257 个多步运维任务上评测控制协议，提出重采样机制：对可疑动作重新采样以积累证据，将攻击成功率从 58\% 压到 7\%，有用性仅损失 5\%。}
}

@article{kutasov2025shade,
  title   = {SHADE-Arena: Evaluating Sabotage and Monitoring in LLM Agents},
  author  = {Kutasov, Jonathan and Sun, Yuqi and Colognese, Paul and van der Weij, Teun and Petrini, Linda and Zhang, Chen Bo Calvin and Hughes, John and Deng, Xiang and Sleight, Henry and Tracy, Tyler and Shlegeris, Buck and Benton, Joe},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.15740},
  eprint  = {2506.15740},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.15740},
  note    = {sabotage and monitoring measured together in long-horizon agents},
  note-zh = {在长程智能体中同时度量破坏与监测},
  tldr    = {SHADE-Arena pairs benign long-horizon agent tasks with hidden sabotage side-tasks and scores both the agent's covert success and an LLM monitor's ability to flag the transcript.},
  tldr-zh = {SHADE-Arena 把良性的长程智能体任务与隐藏的破坏性副任务配对，同时评估智能体隐蔽完成副任务的能力和 LLM 监测器识别记录的能力。}
}
