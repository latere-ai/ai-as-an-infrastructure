@article{burns2024weak,
  title   = {Weak-to-Strong Generalization: Eliciting Strong Capabilities With Weak Supervision},
  author  = {Burns, Collin and Izmailov, Pavel and Kirchner, Jan Hendrik and Baker, Bowen and Gao, Leo and Aschenbrenner, Leopold and Chen, Yining and Ecoffet, Adrien and Joglekar, Manas and Leike, Jan and Sutskever, Ilya and Wu, Jeff},
  year    = {2024},
  journal = {arXiv preprint arXiv:2312.09390},
  eprint  = {2312.09390},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2312.09390},
  tldr    = {Burns et al. show that finetuning a strong pretrained model on weak-model-generated labels consistently surpasses the weak supervisor, framing this weak-to-strong generalization as an empirical proxy for superalignment.},
  tldr-zh = {Burns 等人证明，用弱模型生成的标签对强预训练模型进行监督微调，所得学生模型能稳定超越弱监督者，并将此"弱到强"泛化现象作为超级对齐问题的实证代理框架。}
}

@article{christiano2018supervising,
  title   = {Supervising Strong Learners by Amplifying Weak Experts},
  author  = {Christiano, Paul and Shlegeris, Buck and Amodei, Dario},
  year    = {2018},
  journal = {arXiv preprint arXiv:1810.08575},
  eprint  = {1810.08575},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/1810.08575},
  note    = {iterated amplification},
  tldr    = {Iterated Amplification trains an ML agent on tasks beyond direct human evaluation by recursively decomposing hard problems into subproblems, using the agent itself to assist the human supervisor.},
  tldr-zh = {迭代放大（Iterated Amplification）通过将超出人类直接评估能力的任务递归分解为子问题，并借助智能体辅助人类监督者，从而为复杂任务提供训练信号。}
}

