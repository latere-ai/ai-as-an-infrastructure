  note-zh       = {GCG 与 AdvBench 有害行为集合},
  tldr    = {GCG introduces an automated greedy coordinate gradient method to find adversarial suffixes that jailbreak aligned LLMs, transferring to black-box models including ChatGPT, Bard, and Claude.},
  tldr-zh = {GCG 提出一种自动化的贪婪坐标梯度方法，通过搜索对抗性后缀实现对已对齐大语言模型的越狱，并可迁移至 ChatGPT、Bard、Claude 等黑盒模型。}
}

