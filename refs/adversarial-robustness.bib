  author        = {Zou, Andy and Phan, Long and Wang, Justin and Duenas, Derek and Lin, Maxwell and Andriushchenko, Maksym and Wang, Rowan and Kolter, J. Zico and Fredrikson, Matt and Hendrycks, Dan},
