  author        = {Russinovich, Mark and Salem, Ahmed and Eldan, Ronen},
  year          = {2024},
  journal       = {arXiv preprint arXiv:2404.01833},
  eprint        = {2404.01833},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2404.01833},
  tldr    = {Crescendo is a multi-turn LLM jailbreak that escalates from benign prompts using the model's own prior outputs, bypassing safety alignment on GPT-4, Gemini-Pro, and other models with high attack success rates.},
  tldr-zh = {Crescendo 是一种多轮大语言模型越狱攻击，通过利用模型自身的历史输出逐步升级无害提示，在 GPT-4、Gemini-Pro 等模型上实现高攻击成功率，绕过安全对齐。}
}

