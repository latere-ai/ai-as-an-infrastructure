  tldr-zh   = {EAGLE 在以已采样词元为条件的同时预测次顶层特征，再由目标模型验证由此产生的词元候选。}
}

@inproceedings{li2024eagle2,
  author    = {Li, Yuhui and Wei, Fangyun and Zhang, Chao and Zhang, Hongyang},
