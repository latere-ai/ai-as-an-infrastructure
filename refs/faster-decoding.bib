% Bibliography for chapter 18 "Faster Decoding".

@article{leviathan2023fast,
  author    = {Leviathan, Yaniv and Kalman, Matan and Matias, Yossi},
  title     = {Fast Inference from Transformers via Speculative Decoding},
  year      = {2023},
  eprint    = {2211.17192},
  url       = {https://arxiv.org/abs/2211.17192},
  tldr    = {Speculative decoding uses a small draft model to propose tokens verified in parallel by the large target model, achieving 2X-3X speedup without changing the output distribution.},
  tldr-zh = {推测解码用一个小型草稿模型提出词元、再由大目标模型并行校验，在不改变输出分布的前提下实现 2X-3X 加速。}
}

@article{chen2023accelerating,
  author    = {Chen, Charlie and Borgeaud, Sebastian and Irving, Geoffrey and Lespiau, Jean-Baptiste and Sifre, Laurent and Jumper, John},
  title     = {Accelerating Large Language Model Decoding with Speculative Sampling},
  year      = {2023},
  eprint    = {2302.01318},
  url       = {https://arxiv.org/abs/2302.01318},
  tldr    = {Speculative sampling uses a small draft model to propose tokens that a large target model verifies in parallel, achieving 2–2.5x decoding speedup on Chinchilla without altering the output distribution.},
  tldr-zh = {推测采样利用小草稿模型生成候选词元，再由大目标模型并行验证，在 Chinchilla 上实现 2–2.5 倍推测解码加速，且不改变输出分布。}
}

@article{cai2024medusa,
  author    = {Cai, Tianle and Li, Yuhong and Geng, Zhengyang and Peng, Hongwu and Lee, Jason D. and Chen, Deming and Dao, Tri},
  title     = {Medusa: Simple LLM Inference Acceleration Framework with Multiple Decoding Heads},
  year      = {2024},
  eprint    = {2401.10774},
  url       = {https://arxiv.org/abs/2401.10774},
  tldr    = {MEDUSA accelerates LLM inference by adding multiple extra decoding heads plus tree-based attention to predict and verify several tokens per step, achieving 2.2-2.8x speedup without a separate draft model.},
  tldr-zh = {MEDUSA 通过在 LLM 上附加多个额外解码头并结合基于树的注意力机制，在每步并行预测并验证多个词元，无需独立草稿模型即可实现 2.2-2.8 倍推测解码加速。}
}

@article{ankner2024hydra,
  author    = {Ankner, Zachary and Parthasarathy, Rishab and Nrusimha, Aniruddha and Rinard, Christopher and Ragan-Kelley, Jonathan and Brandon, William},
  title     = {Hydra: Sequentially-Dependent Draft Heads for Medusa Decoding},
  year      = {2024},
  eprint    = {2402.05109},
  url       = {https://arxiv.org/abs/2402.05109},
  tldr    = {Hydra heads are sequentially-dependent draft heads for speculative decoding that condition each prediction on prior candidate tokens, improving throughput by up to 2.70x over autoregressive decoding.},
  tldr-zh = {Hydra heads 是一种序列相关的草稿头，用于推测解码，通过将每次预测条件化于先前候选词元，相比自回归解码最高提升 2.70 倍吞吐量。}
}

@article{li2024eagle,
  author    = {Li, Yuhui and Wei, Fangyun and Zhang, Chao and Zhang, Hongyang},
  title     = {EAGLE: Speculative Sampling Requires Rethinking Feature Uncertainty},
  year      = {2024},
  eprint    = {2401.15077},
  url       = {https://arxiv.org/abs/2401.15077},
  tldr    = {EAGLE is a speculative decoding framework that predicts second-to-top-layer features conditioned on a one-step-ahead token sequence, achieving 2.7x-3.5x latency speedup over autoregressive LLM decoding with lossless output distribution.},
  tldr-zh = {EAGLE 是一种推测解码框架，通过以超前一步的词元序列为条件预测次顶层特征，在保持输出分布不变的情况下实现对自回归 LLM 解码 2.7x-3.5x 的延迟加速。}
}

@article{li2024eagle2,
  author    = {Li, Yuhui and Wei, Fangyun and Zhang, Chao and Zhang, Hongyang},
  title     = {EAGLE-2: Faster Inference of Language Models with Dynamic Draft Trees},
  year      = {2024},
  eprint    = {2406.16858},
  url       = {https://arxiv.org/abs/2406.16858},
  tldr    = {EAGLE-2 improves speculative decoding by replacing static draft trees with context-aware dynamic draft trees, achieving 3.05x-4.26x lossless LLM inference speedup without additional training.},
  tldr-zh = {EAGLE-2 将推测解码中的静态草稿树替换为上下文感知的动态草稿树，无需额外训练即可实现 3.05x-4.26x 的无损 LLM 推理加速。}
}

@article{li2025eagle3,
  author    = {Li, Yuhui and Wei, Fangyun and Zhang, Chao and Zhang, Hongyang},
  title     = {EAGLE-3: Scaling up Inference Acceleration of Large Language Models via Training-Time Test},
  year      = {2025},
  eprint    = {2503.01840},
  url       = {https://arxiv.org/abs/2503.01840},
  tldr    = {EAGLE-3 replaces feature prediction with direct token prediction and multi-layer feature fusion via training-time test, enabling a scaling law for speculative decoding that achieves up to 6.5x inference speedup.},
  tldr-zh = {EAGLE-3 用直接词元预测和多层特征融合替代特征预测，通过 training-time test 技术发现推测解码的扩展律，推理加速比最高达 6.5x。}
}

@article{fu2024lookahead,
  author    = {Fu, Yichao and Bailis, Peter and Stoica, Ion and Zhang, Hao},
  title     = {Break the Sequential Dependency of LLM Inference Using Lookahead Decoding},
  year      = {2024},
  eprint    = {2402.02057},
  url       = {https://arxiv.org/abs/2402.02057},
  tldr    = {Lookahead Decoding accelerates LLM autoregressive decoding without a draft model by generating and verifying n-grams in parallel via Jacobi iteration, achieving up to 4x speedup.},
  tldr-zh = {Lookahead Decoding 无需草稿模型，通过 Jacobi 迭代并行生成并验证 n-gram，将大语言模型自回归解码速度提升最高 4 倍。}
}

@article{gloeckle2024multi,
  author    = {Gloeckle, Fabian and Idrissi, Badr Youbi and Rozi{\`e}re, Baptiste and Lopez-Paz, David and Synnaeve, Gabriel},
  title     = {Better \& Faster Large Language Models via Multi-token Prediction},
  year      = {2024},
  eprint    = {2404.19737},
  url       = {https://arxiv.org/abs/2404.19737},
  tldr    = {Training LLMs with n independent output heads to predict multiple future tokens simultaneously improves sample efficiency, boosts coding benchmarks by ~15%, and enables 3x faster inference via self-speculative decoding.},
  tldr-zh = {通过让大语言模型使用 n 个独立输出头同时预测多个未来词元，可提升样本效率、在代码基准上提升约 15%，并借助自推测解码实现 3 倍推理加速。}
}

