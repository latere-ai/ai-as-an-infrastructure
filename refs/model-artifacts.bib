@misc{reversinglabs2025nullifai,
  author       = {{ReversingLabs}},
  title        = {nullifAI: malicious ML models evade Hugging Face picklescan},
  year         = {2025},
  url          = {https://www.reversinglabs.com/blog/rl-identifies-malware-ml-model-hosted-on-hugging-face},
  note         = {scanning a program format is a cat-and-mouse game},
  note-zh      = {扫描一种程序格式是一场猫鼠游戏},
