  author        = {Zhu, Ruidong and Jiang, Ziheng and Jin, Chao and Wu, Peng and Stuardo, Cesar A. and Wang, Dongyang and Zhang, Xinlei and Zhou, Huaping and Wei, Haoran and Cheng, Yang and Xiao, Jianzhe and Zhang, Xinyi and Liu, Lingjun and Lin, Haibin and Chang, Li-Wen and Ye, Jianxi and Yu, Xiao and Liu, Xuanzhe and Jin, Xin and Liu, Xin},
  year          = {2025},
