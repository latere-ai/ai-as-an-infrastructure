  author        = {Ozeri, Or and Harnik, Danny and Schaffer, Ronen and Etelis, Itay and Rabindranath, Varun Sundar},
  year          = {2026},
  month         = sep,
  howpublished  = {vLLM blog},
  url           = {https://vllm.ai/blog/2026-09-10-tiered-kv-offloading},
  note          = {host-centric KV offload to storage and peer tiers},
  note-zh       = {以主机内存为中心、向存储和对等节点逐级卸载 KV},
  tldr          = {vLLM routes all offloaded KV data through host memory, frees accelerator memory once the host copy completes, allocates it on reload only after the data is back in host memory, and reports that a storage tier more than doubled throughput once conversations outgrew host memory.},
  tldr-zh       = {vLLM 让所有卸载的 KV 数据都经过主机内存：主机副本写完即释放加速器内存，重新载入时等数据回到主机内存才分配加速器内存；文中报告，当对话数量超出主机内存容量后，存储层让吞吐量提高到原来的两倍以上。},
  further       = {no}
}

@article{bhatia2025helix,
  title         = {Helix Parallelism: Rethinking Sharding Strategies for Interactive Multi-Million-Token {LLM} Decoding},
  author        = {Bhatia, Nidhi and More, Ankit and Borkar, Ritika and Mitra, Tiyasa and Matas, Ramon and Zhao, Ritchie and Golub, Maximilian and Mudigere, Dheevatsa and Pharris, Brian and Rouhani, Bita Darvish},
  year          = {2025},
  journal       = {arXiv preprint arXiv:2507.07120},
  eprint        = {2507.07120},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2507.07120},
  note          = {sharding the KV cache by sequence during attention},
  note-zh       = {注意力阶段按序列切分 KV 缓存},
  tldr          = {Helix shards long KV caches across GPUs during attention, where tensor parallelism would duplicate KV heads, and reuses the same GPUs for tensor or expert parallelism in the FFN, keeping attention exact with a small communication step.},
  tldr-zh       = {Helix 在注意力阶段把长 KV 缓存切分到多块 GPU 上，避免张量并行重复存储 KV 头，再让同一组 GPU 在 FFN 阶段执行张量并行或专家并行，并用一次轻量通信保持注意力结果精确。},
