@inproceedings{zhou2023lima,
  title   = {LIMA: Less Is More for Alignment},
  author  = {Zhou, Chunting and Liu, Pengfei and Xu, Puxin and Iyer, Srini and Sun, Jiao and Mao, Yuning and Ma, Xuezhe and Efrat, Avia and Yu, Ping and Yu, Lili and Zhang, Susan and Ghosh, Gargi and Lewis, Mike and Zettlemoyer, Luke and Levy, Omer},
  year    = {2023},
  booktitle = {Advances in Neural Information Processing Systems 36},
  eprint  = {2305.11206},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.11206},
  tldr    = {LIMA fine-tunes a 65B LLaMA model on 1,000 curated prompt-response pairs and reports strong format learning and conversational behavior, motivating the superficial-alignment hypothesis in that setting.},
  tldr-zh = {LIMA 表明，仅用 1,000 条精心筛选的提示-回复对对 65B LLaMa 模型进行监督微调（无需 RLHF）即可实现强对齐效果，支持了"表层对齐假说"。}
}

@inproceedings{hu2021lora,
  title   = {LoRA: Low-Rank Adaptation of Large Language Models},
  author  = {Hu, Edward J. and Shen, Yelong and Wallis, Phillip and Allen-Zhu, Zeyuan and Li, Yuanzhi and Wang, Shean and Wang, Lu and Chen, Weizhu},
  year    = {2022},
  booktitle = {International Conference on Learning Representations},
  eprint  = {2106.09685},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2106.09685},
  tldr    = {LoRA freezes pretrained weights and trains additive low-rank factors for selected matrices; the paper reports large trainable-state savings and competitive results in its evaluated settings.},
  tldr-zh = {LoRA 冻结预训练权重，向每个 Transformer 层注入可训练的低秩矩阵对，与全量微调相比可将可训练参数减少 10,000 倍、将 GPU 显存需求降低 3 倍，且不引入额外推理延迟。}
}

@inproceedings{dettmers2023qlora,
  title   = {QLoRA: Efficient Finetuning of Quantized LLMs},
  author  = {Dettmers, Tim and Pagnoni, Artidoro and Holtzman, Ari and Zettlemoyer, Luke},
  year    = {2023},
  booktitle = {Advances in Neural Information Processing Systems 36},
  pages   = {10088--10115},
  eprint  = {2305.14314},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.14314},
  tldr    = {QLoRA stores the frozen base in 4-bit NF4 and trains LoRA adapters in higher precision, using double quantization and paged optimizers; the paper demonstrates one 65B setup on a 48 GB GPU.},
  tldr-zh = {QLoRA 通过将冻结的 4 位量化模型的梯度反向传播至 LoRA 低秩适配器，并引入 NF4、双重量化和分页优化器，实现在单张 48GB GPU 上对 65B 参数大语言模型进行参数高效微调。}
}

@inproceedings{houlsby2019parameter,
  title     = {Parameter-Efficient Transfer Learning for NLP},
  author    = {Houlsby, Neil and Giurgiu, Andrei and Jastrzebski, Stanislaw and Morrone, Bruna and de Laroussilhe, Quentin and Gesmundo, Andrea and Attariyan, Mona and Gelly, Sylvain},
  year      = {2019},
  booktitle = {Proceedings of the 36th International Conference on Machine Learning (ICML)},
  volume    = {97},
  pages     = {2790--2799},
  eprint    = {1902.00751},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/1902.00751},
  note      = {adapters},
  tldr    = {Adapter modules inserted into BERT layers match full fine-tuning performance on GLUE while training only 3.6\% as many parameters per task.},
  tldr-zh = {向 BERT 各层插入适配器模块，仅训练全量参数高效微调（PEFT）的 3.6\%，即可在 GLUE 上达到接近完全微调的性能。}
}

@inproceedings{wortsman2022soups,
  title     = {Model Soups: Averaging Weights of Multiple Fine-Tuned Models Improves Accuracy Without Increasing Inference Time},
  author    = {Wortsman, Mitchell and Ilharco, Gabriel and Gadre, Samir Yitzhak and Roelofs, Rebecca and Gontijo-Lopes, Raphael and Morcos, Ari S. and Namkoong, Hongseok and Farhadi, Ali and Carmon, Yair and Kornblith, Simon and Schmidt, Ludwig},
  year      = {2022},
  booktitle = {Proceedings of the 39th International Conference on Machine Learning (ICML)},
  volume    = {162},
  pages     = {23965--23998},
  eprint    = {2203.05482},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2203.05482},
  tldr    = {For compatible models from the same fine-tuning sweep, the paper reports that selected weight averages can outperform the best individual checkpoint without ensemble inference cost.},
  tldr-zh = {对多个微调模型的权重取平均（称为"模型汤"）可在不增加推理成本的前提下，优于最佳单一模型并提升分布外鲁棒性。}
}

@inproceedings{ilharco2023task,
  title     = {Editing Models with Task Arithmetic},
  author    = {Ilharco, Gabriel and Ribeiro, Marco Tulio and Wortsman, Mitchell and Gururangan, Suchin and Schmidt, Ludwig and Hajishirzi, Hannaneh and Farhadi, Ali},
  year      = {2023},
  booktitle = {International Conference on Learning Representations (ICLR)},
  eprint    = {2212.04089},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2212.04089},
  tldr    = {Task arithmetic defines same-base fine-tuning deltas and reports that scaled addition or negation steers behavior in the paper's evaluated models and tasks.},
  tldr-zh = {任务算术提出任务向量（微调权重减去预训练权重所得方向），通过对其取负或相加即可在无需重新训练的情况下编辑模型行为。}
}

@article{yadav2023ties,
  title   = {TIES-Merging: Resolving Interference When Merging Models},
  author  = {Yadav, Prateek and Tam, Derek and Choshen, Leshem and Raffel, Colin and Bansal, Mohit},
  year    = {2023},
  journal = {Advances in Neural Information Processing Systems 36},
  pages   = {7093--7115},
  eprint  = {2306.01708},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2306.01708},
  tldr    = {TIES-Merging trims small same-base deltas, elects a sign per coordinate, and averages updates that agree with that sign to reduce measured merge interference.},
  tldr-zh = {TIES-MERGING 是一种无需训练的模型合并方法，通过裁剪冗余参数、解决符号冲突、仅对符号对齐的参数求平均，将多个微调模型合并为单一多任务模型。}
}

@inproceedings{yu2024dare,
  title     = {Language Models are Super Mario: Absorbing Abilities from Homologous Models as a Free Lunch},
  author    = {Yu, Le and Yu, Bowen and Yu, Haiyang and Huang, Fei and Li, Yongbin},
  year      = {2024},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning (ICML)},
  volume    = {235},
  pages     = {57755--57775},
  eprint    = {2311.03099},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2311.03099},
  note      = {DARE},
  tldr    = {DARE randomly drops and rescales same-base fine-tuning deltas before applying another merge rule, with performance depending on compatible source models and chosen sparsity.},
  tldr-zh = {DARE 通过随机丢弃并重缩放监督微调（SFT）的增量参数，使多个任务专用语言模型无需重新训练即可合并为单一模型。}
}

@article{ouyang2022instructgpt,
  title   = {Training Language Models to Follow Instructions with Human Feedback},
  author  = {Ouyang, Long and Wu, Jeffrey and Jiang, Xu and Almeida, Diogo and Wainwright, Carroll L. and Mishkin, Pamela and Zhang, Chong and Agarwal, Sandhini and Slama, Katarina and Ray, Alex and Schulman, John and Hilton, Jacob and Kelton, Fraser and Miller, Luke and Simens, Maddie and Askell, Amanda and Welinder, Peter and Christiano, Paul and Leike, Jan and Lowe, Ryan},
  year    = {2022},
  journal = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint  = {2203.02155},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2203.02155},
  note    = {InstructGPT's supervised demonstration stage before reward modeling and PPO},
  tldr    = {InstructGPT trains on labeler demonstrations, then preference rankings and reinforcement learning; its final assistant behavior is evidence about the full pipeline, not SFT alone.},
  tldr-zh = {InstructGPT 先使用标注者示范训练，再使用偏好排序和强化学习；最终助手行为反映的是整条流程，而不是单独的监督微调。}
}

@misc{schulman2025lora,
  title        = {LoRA Without Regret},
  author       = {Schulman, John and others},
  year         = {2025},
  howpublished = {Thinking Machines Lab: Connectionism},
  url          = {https://thinkingmachines.ai/blog/lora/},
  note         = {company experiments on target modules, rank, batch size, and learning rate},
  tldr         = {A 2025 company research report comparing LoRA and full fine-tuning across specified Llama and Qwen experiments, including target-layer, rank, batch-size, and learning-rate sweeps.},
  tldr-zh      = {大规模实验表明，把 LoRA 施加到所有线性层（含 MLP 与 MoE）并以完整微调约十倍的学习率训练时，效果与完整微调相当；只作用于注意力层会明显欠佳，而在 RL 后训练中即便秩为 1，LoRA 也能追平完整微调。}
}

@inproceedings{wei2022flan,
  title         = {Finetuned Language Models Are Zero-Shot Learners},
  author        = {Wei, Jason and Bosma, Maarten and Zhao, Vincent Y. and Guu, Kelvin and Yu, Adams Wei and Lester, Brian and Du, Nan and Dai, Andrew M. and Le, Quoc V.},
  year          = {2022},
  booktitle     = {International Conference on Learning Representations},
  eprint        = {2109.01652},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2109.01652},
  note          = {instruction tuning across more than 60 tasks and evaluation on held-out task types},
  further       = {no},
  tldr          = {FLAN reports that instruction tuning across many tasks improves zero-shot performance on held-out task types, with task diversity and natural-language instructions important in its ablations.},
  tldr-zh       = {FLAN 报告称，在多种任务上进行指令微调可提高未见任务类型上的零样本表现，其消融实验显示任务多样性和自然语言指令都很重要。}
}

@inproceedings{lester2021prompt,
  title         = {The Power of Scale for Parameter-Efficient Prompt Tuning},
  author        = {Lester, Brian and Al-Rfou, Rami and Constant, Noah},
  year          = {2021},
  booktitle     = {Proceedings of the 2021 Conference on Empirical Methods in Natural Language Processing},
  eprint        = {2104.08691},
