  author  = {Dong, Hanze and Xiong, Wei and Goyal, Deepanshu and Zhang, Yihan and Chow, Winnie and Pan, Rui and Diao, Shizhe and Zhang, Jipeng and Shum, Kashun and Zhang, Tong},
  year    = {2023},
  journal = {arXiv preprint arXiv:2304.06767},
  eprint  = {2304.06767},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2304.06767},
  note    = {rejection-sampling fine-tuning},
  tldr    = {RAFT aligns generative models by iteratively sampling outputs, scoring them with a reward model, and fine-tuning only on the top-ranked subset, replacing PPO with a stable SFT-style loop.},
  tldr-zh = {RAFT（奖励排序微调）通过迭代采样模型输出、用奖励模型评分并仅对高分子集做监督微调，以稳定的方式替代 PPO 完成大语言模型与扩散模型的对齐。}
}

