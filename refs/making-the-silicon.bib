@misc{bis2026rule,
  author       = {{U.S. Bureau of Industry and Security}},
  title        = {Revision to License Review Policy for Advanced Computing Commodities},
  year         = {2026},
  howpublished = {Federal Register, document 2026-00789},
  url          = {https://www.federalregister.gov/documents/2026/01/15/2026-00789/revision-to-license-review-policy-for-advanced-computing-commodities},
  note         = {the Jan 2026 rule, with the total-processing-performance and memory-bandwidth thresholds},
  note-zh      = {2026 年 1 月的规则，带总处理性能与内存带宽阈值},
  tldr    = {BIS moves exports to China and Macau of advanced computing commodities under a total processing performance of 21,000 and a total DRAM bandwidth of 6,500 GB/s, such as the NVIDIA H200 and AMD MI325X, from a presumption of denial to case-by-case license review, conditioned on exporter certifications, independent third-party testing in the United States, and an aggregate exported performance no greater than 50 percent of what ships to US customers.},
  tldr-zh = {BIS 把面向中国与澳门、总处理性能低于 21,000 且总 DRAM 带宽低于 6,500 GB/s 的先进计算部件（如 NVIDIA H200、AMD MI325X）出口，从推定拒绝改为逐案许可审查，条件包括出口方证明、由美国境内独立第三方测试，以及出口总处理性能合计不超过面向美国客户出货量的 50\%。}
}

