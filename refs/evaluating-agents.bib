@article{berdoz2026agree,
  title         = {Can AI Agents Agree?},
  author        = {Berdoz, Fr{\'e}d{\'e}ric and Rugli, Leonardo and Wattenhofer, Roger},
  year          = {2026},
  journal       = {arXiv preprint arXiv:2603.01213},
