  title   = {Goalless Agents},
  year    = {2026},
  howpublished = {Experiment repository, GitHub},
  url     = {https://github.com/changkun/goalless-agents},
  further = {no},
  note    = {the controlled harness-swap study behind this chapter's pinning and failure-classification discipline},
  note-zh = {本章固定条件与失败分类纪律背后的运行框架对调对照研究},
  tldr    = {Controlled runs of the same models under swapped harnesses show which behaviors are model traits and which move with the scaffold, that a CLI point release alone can change agent behavior, and that exit codes cannot classify agent outcomes, motivating full conditioning-tuple pinning and derived usable-N reporting.},
