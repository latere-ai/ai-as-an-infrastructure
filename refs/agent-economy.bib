  title     = {Project Deal: our Claude-run marketplace experiment},
  year      = {2026},
  url       = {https://www.anthropic.com/features/project-deal},
  note      = {186 machine-negotiated deals and invisible model-quality inequality},
  note-zh   = {186 笔机器谈成的交易，与看不见的模型质量不平等},
