@misc{szabo1999micropayments,
  author  = {Szabo, Nick},
  title   = {Micropayments and Mental Transaction Costs},
  year    = {1999},
  url     = {https://nakamotoinstitute.org/library/micropayments-and-mental-transaction-costs/},
  note    = {why reducing the fee does not remove the work of deciding},
  note-zh = {为什么降低手续费并不能消除决策工作},
  tldr    = {Szabo argues that attention, preference specification, monitoring, and dispute costs can dominate the price of a tiny purchase, including when software agents make it.},
  tldr-zh = {Szabo 论证，注意力、偏好设定、监控与争议成本可能超过小额购买本身的价格，即使由软件智能体执行也一样。}
}

@inproceedings{glassman1995millicent,
