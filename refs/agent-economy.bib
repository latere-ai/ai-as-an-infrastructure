@misc{szabo1999micropayments,
  author    = {Szabo, Nick},
  title     = {Micropayments and Mental Transaction Costs},
  year      = {1999},
  url       = {https://nakamotoinstitute.org/library/micropayments-and-mental-transaction-costs/},
  note      = {the 27-year-old argument that still governs the design space},
  note-zh   = {二十七年后仍然支配这个设计空间的论证},
  tldr    = {The argument that killed 1990s micropayments: the binding cost of a tiny purchase is the decision, not the fee, and Szabo's own skepticism about delegating those decisions to agents reads as prophecy.},
  tldr-zh = {判了 1990 年代微支付死刑的论证：小额购买真正的成本是决策而非手续费；Szabo 对把决策委托给智能体的怀疑，如今读来像预言。}
}

@inproceedings{glassman1995millicent,
  author    = {Glassman, Steve and Manasse, Mark and Abadi, Mart{\'i}n and Gauthier, Paul and Sobalvarro, Patrick},
  title     = {The Millicent Protocol for Inexpensive Electronic Commerce},
  booktitle = {Fourth International World Wide Web Conference (WWW4)},
  year      = {1995},
  url       = {https://www.w3.org/Conferences/WWW4/Papers/246/},
  note      = {sub-cent payments designed for a human who never came},
  note-zh   = {为一个始终没来的人类用户设计的亚分级支付},
  tldr    = {DEC's broker-and-scrip design for transactions down to a tenth of a cent, a working answer to machine-granularity payment thirty years before there were machines to spend it.},
  tldr-zh = {DEC 的经纪商加代币设计，支持低至千分之一美元的交易；这是机器粒度支付的可行答案，只是比会花钱的机器早了三十年。}
}

@misc{rfc9110,
  author    = {Fielding, Roy and Nottingham, Mark and Reschke, Julian},
  title     = {HTTP Semantics (RFC 9110), Section 15.5.3: 402 Payment Required},
  year      = {2022},
  url       = {https://www.rfc-editor.org/rfc/rfc9110.html},
  note      = {the one-sentence placeholder that waited 25 years},
  note-zh   = {等了二十五年的一句占位符},
  tldr    = {The HTTP status code whose entire specification reads "reserved for future use," sitting in the protocol since HTTP/1.1 waiting for a payer without mental transaction costs.},
  tldr-zh = {这个 HTTP 状态码的全部规范只有一句「保留供将来使用」，自 HTTP/1.1 起就待在协议里，等一个没有心智交易成本的付款方。}
}

@misc{coinbase2025x402,
  author    = {{Coinbase}},
  title     = {Introducing x402: a new standard for internet-native payments},
  year      = {2025},
