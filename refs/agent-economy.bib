@article{riedl2025law,
  author    = {Riedl, Mark O. and Desai, Deven R.},
  title     = {AI Agents and the Law},
  year      = {2025},
  journal   = {arXiv preprint arXiv:2508.08544},
  eprint    = {2508.08544},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2508.08544},
  note      = {why CS undertheorizes what agency law cares about},
  note-zh   = {计算机科学为何低估了代理法真正关心的东西},
