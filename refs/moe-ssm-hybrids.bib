@inproceedings{lewis2021base,
  title     = {BASE Layers: Simplifying Training of Large, Sparse Models},
  author    = {Lewis, Mike and Bhosale, Shruti and Dettmers, Tim and Goyal, Naman and Zettlemoyer, Luke},
  booktitle = {Proceedings of the 38th International Conference on Machine Learning (ICML)},
  year      = {2021},
  eprint    = {2103.16716},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2103.16716},
  note      = {Routing as assignment, for contrast},
  note-zh   = {把路由视作指派问题，作为对照},
  tldr    = {BASE layers replace MoE routing heuristics and auxiliary balancing losses by formulating token-to-expert assignment as a linear assignment problem, guaranteeing equal load across experts with no new hyperparameters.},
  tldr-zh = {BASE 层将词元到专家的分配建模为线性分配问题，无需辅助损失或额外超参数即可保证混合专家（MoE）模型中各专家负载均衡。}
}

