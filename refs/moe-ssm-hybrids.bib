  note-zh = {独立的无辅助损失均衡方法，区别于 DeepSeek-V3 报告}
}

@inproceedings{gu2021s4,
  title     = {Efficiently Modeling Long Sequences with Structured State Spaces},
  author    = {Gu, Albert and Goel, Karan and R{\'e}, Christopher},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2021},
  eprint    = {2111.00396},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2111.00396},
  note      = {S4},
  tldr    = {S4 introduces a structured parameterization of SSMs via low-rank plus normal decomposition, enabling O(N+L) computation and state-of-the-art performance on long-range sequence benchmarks including the previously unsolved Path-X task.},
  tldr-zh = {S4 通过低秩加正规矩阵分解重参数化状态空间模型（SSM），实现 O(N+L) 计算复杂度，并在长程序列基准（包括此前无模型能解的 Path-X 任务）上达到最优性能。}
}

@article{gu2023mamba,
  title   = {Mamba: Linear-Time Sequence Modeling with Selective State Spaces},
  author  = {Gu, Albert and Dao, Tri},
  year    = {2023},
  eprint  = {2312.00752},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2312.00752},
  tldr    = {Mamba introduces selective SSMs with input-dependent parameters and a hardware-aware parallel scan, achieving Transformer-quality language modeling with linear-time inference and training.},
  tldr-zh = {Mamba 提出带输入依赖参数的选择性状态空间模型（SSM）和硬件感知并行扫描算法，以线性时间复杂度实现与 Transformer 相当的语言建模质量。}
}

@inproceedings{dao2024mamba2,
  title     = {Transformers are SSMs: Generalized Models and Efficient Algorithms Through Structured State Space Duality},
  author    = {Dao, Tri and Gu, Albert},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning (ICML)},
  year      = {2024},
  eprint    = {2405.21060},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2405.21060},
  note      = {Mamba-2},
  tldr    = {Mamba-2 unifies selective SSMs and attention via a structured state space duality (SSD) framework over semiseparable matrices, yielding a 2-8x faster SSM layer competitive with Transformers on language modeling.},
  tldr-zh = {Mamba-2 通过半可分矩阵建立状态空间模型（SSM）与注意力之间的结构化状态空间对偶（SSD）框架，使 SSM 层训练速度提升 2-8 倍，在语言建模上与 Transformer 竞争。}
}

@article{yang2024gateddeltanet,
  title   = {Gated Delta Networks: Improving Mamba2 with Delta Rule},
  author  = {Yang, Songlin and Kautz, Jan and Hatamizadeh, Ali},
  year    = {2024},
  journal = {arXiv preprint arXiv:2412.06464},
  eprint  = {2412.06464},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2412.06464},
  note    = {Gated DeltaNet},
  tldr    = {Gated DeltaNet combines a gated forgetting mechanism with delta-rule state updates in a linear-attention recurrence, surpassing Mamba2 and DeltaNet on language modeling and long-context tasks.},
  tldr-zh = {Gated DeltaNet 在线性注意力递归中把门控遗忘机制与 delta 规则的状态更新结合起来，在语言建模与长上下文任务上超过 Mamba2 与 DeltaNet。}
}

@article{lieber2024jamba,
  title   = {Jamba: A Hybrid Transformer-Mamba Language Model},
  author  = {Lieber, Opher and Lenz, Barak and Bata, Hofit and Cohen, Gal and Osin, Jhonathan and Dalmedigos, Itay and Safahi, Erez and Meirom, Shaked and Belinkov, Yonatan and Shalev-Shwartz, Shai and Abend, Omri and Alon, Raz and Asida, Tomer and Bergman, Amir and Glozman, Roman and Gokhman, Michael and Manevich, Avshalom and Ratner, Nir and Rozen, Noam and Shwartz, Erez and Zusman, Mor and Shoham, Yoav},
  year    = {2024},
  eprint  = {2403.19887},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2403.19887},
  tldr    = {Jamba is a large language model built on a hybrid Transformer-Mamba MoE architecture that achieves 256K token context length and 3x throughput over Mixtral-8x7B while fitting in a single 80GB GPU.},
  tldr-zh = {Jamba 是基于混合 Transformer-Mamba 混合专家架构的大语言模型，支持 256K 词元上下文，在单张 80GB GPU 上实现比 Mixtral-8x7B 高 3 倍的吞吐量。}
}

@article{minimax2025minimax01,
  title   = {MiniMax-01: Scaling Foundation Models with Lightning Attention},
  author  = {{MiniMax}},
  year    = {2025},
  journal = {arXiv preprint arXiv:2501.08313},
  eprint  = {2501.08313},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2501.08313},
  note    = {456B lightning-attention hybrid},
  note-zh = {456B 的 lightning attention 混合体},
  tldr    = {MiniMax-01 interleaves lightning attention (a linear attention) with softmax attention in a 456B-parameter MoE model, reaching million-token contexts at frontier quality.},
  tldr-zh = {MiniMax-01 在一个 456B 参数的 MoE 模型里交错排布 lightning attention（一种线性注意力）与 softmax 注意力，以前沿质量支撑百万词元上下文。}
}

@misc{qwen2025qwen3next,
  title        = {Qwen3-Next-80B-A3B-Instruct Model Card},
  author       = {{Qwen Team}},
  year         = {2025},
  howpublished = {\url{https://huggingface.co/Qwen/Qwen3-Next-80B-A3B-Instruct}},
  url          = {https://huggingface.co/Qwen/Qwen3-Next-80B-A3B-Instruct},
  note         = {Gated DeltaNet and gated attention at roughly 3:1},
  note-zh      = {Gated DeltaNet 与门控注意力约 3:1 排布},
  tldr         = {Qwen3-Next is an 80B-total, 3B-active MoE model whose 48 layers alternate three Gated DeltaNet linear-attention layers with one gated full-attention layer.},
  tldr-zh      = {Qwen3-Next 是总参数 80B、激活 3B 的 MoE 模型，48 层按三层 Gated DeltaNet 线性注意力配一层门控全注意力交替排布。}
}

@article{nvidia2025nemotronh,
  title   = {Nemotron-H: A Family of Accurate and Efficient Hybrid Mamba-Transformer Models},
  author  = {{NVIDIA}},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.03624},
  eprint  = {2504.03624},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.03624},
  note    = {Mamba-attention hybrids at 8B and 56B},
  note-zh = {8B 与 56B 的 Mamba 与注意力混合模型},
  tldr    = {Nemotron-H replaces most attention layers with Mamba layers in 8B and 56B models, matching Transformer accuracy at up to 3x faster long-context inference.},
  tldr-zh = {Nemotron-H 在 8B 与 56B 模型里把大部分注意力层换成 Mamba 层，在保持 Transformer 精度的同时把长上下文推理加速最多 3 倍。}
}

@misc{minimax2025m2attention,
  title        = {Why Did M2 End Up as a Full Attention Model?},
  author       = {Sun, Haohai},
  year         = {2025},
  howpublished = {\url{https://www.minimax.io/news/why-did-m2-end-up-as-a-full-attention-model}},
  url          = {https://www.minimax.io/news/why-did-m2-end-up-as-a-full-attention-model},
  note         = {a frontier lab's case for reverting to full attention},
  note-zh      = {一家前沿实验室退回全注意力的理由},
  tldr         = {MiniMax's pre-training lead explains why M2 dropped the hybrid lightning-attention design: hybrid deficits surfaced only at scale on multi-hop reasoning, and the inference and evaluation stack around efficient attention is not yet production-mature.},
  tldr-zh      = {MiniMax 预训练负责人解释 M2 为何放弃 lightning attention 混合设计：混合体的短板要到规模上去后才在多跳推理上显形，而高效注意力周边的推理与评估栈尚未达到生产成熟度。}
}
