@inproceedings{wei2022chainofthought,
  title     = {Chain-of-Thought Prompting Elicits Reasoning in Large Language Models},
  author    = {Wei, Jason and Wang, Xuezhi and Schuurmans, Dale and Bosma, Maarten and Ichter, Brian and Xia, Fei and Chi, Ed H. and Le, Quoc V. and Zhou, Denny},
  year      = {2022},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint    = {2201.11903},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2201.11903},
  tldr    = {Chain-of-thought prompting, which adds intermediate reasoning steps as few-shot exemplars, significantly improves large language model performance on arithmetic, commonsense, and symbolic reasoning tasks.},
  tldr-zh = {思维链（CoT）提示通过在少样本示例中加入中间推理步骤，显著提升了大语言模型（LLM）在算术、常识与符号推理任务上的性能。}
}

@inproceedings{kojima2022zeroshot,
  title     = {Large Language Models are Zero-Shot Reasoners},
  author    = {Kojima, Takeshi and Gu, Shixiang Shane and Reid, Machel and Matsuo, Yutaka and Iwasawa, Yusuke},
  year      = {2022},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint    = {2205.11916},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2205.11916},
  note      = {zero-shot CoT},
  tldr    = {Zero-shot-CoT uses a task-agnostic reasoning prompt followed by a separate answer-extraction prompt, improving several arithmetic, symbolic, and logical-reasoning benchmarks without task-specific few-shot examples.},
  tldr-zh = {在问题后添加"Let's think step by step"（Zero-shot-CoT）无需任务特定的少样本示例，即可大幅提升 LLM 在算术和符号推理任务上的思维链（CoT）推理能力。}
}

@inproceedings{wang2022selfconsistency,
  title     = {Self-Consistency Improves Chain of Thought Reasoning in Language Models},
  author    = {Wang, Xuezhi and Wei, Jason and Schuurmans, Dale and Le, Quoc and Chi, Ed and Narang, Sharan and Chowdhery, Aakanksha and Zhou, Denny},
  year      = {2023},
  booktitle = {International Conference on Learning Representations},
  eprint    = {2203.11171},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2203.11171},
  tldr    = {Self-consistency samples multiple chain-of-thought paths and returns the most frequent extracted answer, improving the reported reasoning benchmarks when the correct answer forms the dominant answer cluster.},
  tldr-zh = {自一致性（self-consistency）通过对思维链（CoT）提示采样多条推理路径并以多数投票选出最一致答案，替代贪婪解码，显著提升大语言模型的推理准确率。}
}

@inproceedings{zhou2022leasttomost,
  title     = {Least-to-Most Prompting Enables Complex Reasoning in Large Language Models},
  author    = {Zhou, Denny and Sch{\"a}rli, Nathanael and Hou, Le and Wei, Jason and Scales, Nathan and Wang, Xuezhi and Schuurmans, Dale and Cui, Claire and Bousquet, Olivier and Le, Quoc and Chi, Ed},
  year      = {2023},
  booktitle = {International Conference on Learning Representations},
  eprint    = {2205.10625},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2205.10625},
  tldr    = {Least-to-most prompting first decomposes a problem, then solves the subproblems sequentially; the paper reports its strongest easy-to-hard generalization on a task-engineered SCAN setup.},
  tldr-zh = {由最少到最多提示法将复杂问题分解为更简单的子问题并顺序求解，使大语言模型能够泛化到比示例更难的问题。}
}

@inproceedings{yao2023tree,
  title     = {Tree of Thoughts: Deliberate Problem Solving with Large Language Models},
  author    = {Yao, Shunyu and Yu, Dian and Zhao, Jeffrey and Shafran, Izhak and Griffiths, Thomas L. and Cao, Yuan and Narasimhan, Karthik},
  year      = {2023},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint    = {2305.10601},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2305.10601},
  tldr    = {Tree of Thoughts (ToT) is a framework that lets LMs explore multiple reasoning paths via tree search with self-evaluation, raising GPT-4's Game of 24 success rate from 4\% to 74\%.},
  tldr-zh = {思维树（ToT）框架让大语言模型通过树搜索探索多条推理路径并自评估，将 GPT-4 在 Game of 24 上的成功率从 4\% 提升至 74\%。}
}

@inproceedings{xie2023selfeval,
  title     = {Self-Evaluation Guided Beam Search for Reasoning},
  author    = {Xie, Yuxi and Kawaguchi, Kenji and Zhao, Yiran and Zhao, James Xu and Kan, Min-Yen and He, Junxian and Xie, Michael Qizhe},
  year      = {2023},
  booktitle = {Advances in Neural Information Processing Systems},
  volume    = {36},
  doi       = {10.52202/075280-1802},
  eprint  = {2305.00633},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.00633},
  tldr    = {This paper proposes a stepwise self-evaluation mechanism integrated with stochastic beam search to guide LLM multi-step reasoning, outperforming Codex baselines by up to 9.56\% on reasoning benchmarks.},
  tldr-zh = {本文提出将逐步自评估机制与随机束搜索结合，引导大语言模型（LLM）多步推理，在 GSM8K 等推理基准上相比 Codex 基线最高提升 9.56\%。}
}

@inproceedings{feng2023alphazero,
  title     = {{AlphaZero}-Like Tree-Search can Guide Large Language Model Decoding and Training},
  author    = {Wan, Ziyu and Feng, Xidong and Wen, Muning and Mcaleer, Stephen Marcus and Wen, Ying and Zhang, Weinan and Wang, Jun},
