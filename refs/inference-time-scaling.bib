@article{lightman2023lets,
  title   = {Let's Verify Step by Step},
  author  = {Lightman, Hunter and Kosaraju, Vineet and Burda, Yura and Edwards, Harri and Baker, Bowen and Lee, Teddy and Leike, Jan and Schulman, John and Sutskever, Ilya and Cobbe, Karl},
  year    = {2023},
  journal = {arXiv preprint arXiv:2305.20050},
  eprint  = {2305.20050},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2305.20050},
  note    = {process reward models for verifier-guided search},
  tldr    = {This paper shows that process supervision (PRM) significantly outperforms outcome supervision for training reward models on MATH, and releases PRM800K, 800,000 step-level human feedback labels.},
  tldr-zh = {本文证明过程奖励模型（PRM）在 MATH 数据集上显著优于结果监督方法，并发布了包含 80 万条步骤级人类反馈标注的 PRM800K 数据集。}
}

@article{zhang2024genrm,
  title   = {Generative Verifiers: Reward Modeling as Next-Token Prediction},
  author  = {Zhang, Lunjun and Hosseini, Arian and Bansal, Hritik and Kazemi, Mehran and Kumar, Aviral and Agarwal, Rishabh},
  year    = {2024},
  journal = {arXiv preprint arXiv:2408.15240},
  eprint  = {2408.15240},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2408.15240},
  note    = {GenRM; ICLR 2025},
  further = {no},
  tldr    = {GenRM trains LLM verifiers with next-token prediction (SFT) instead of discriminative classification, enabling CoT reasoning and majority-voting at test time to improve Best-of-N selection on reasoning tasks.},
  tldr-zh = {GenRM 用下一词元预测（监督微调）代替判别式分类来训练验证器，使其支持思维链推理和多数投票，从而提升推理任务中 Best-of-N 的选择准确率。}
}

@article{madaan2023selfrefine,
  title   = {Self-Refine: Iterative Refinement with Self-Feedback},
  author  = {Madaan, Aman and Tandon, Niket and Gupta, Prakhar and others},
  year    = {2023},
  journal = {arXiv preprint arXiv:2303.17651},
  eprint  = {2303.17651},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2303.17651},
  note    = {NeurIPS 2023; inference-time self-feedback, no extra training},
  further = {no},
  tldr    = {SELF-REFINE lets a single LLM iteratively generate feedback on its own output and refine it at test time, with no training or RL, improving performance by about 20\% absolute across seven tasks with GPT-3.5 and GPT-4.},
  tldr-zh = {SELF-REFINE 让单个大语言模型在测试时对自身输出迭代生成反馈并精炼，无需训练或强化学习，在七项任务上使用 GPT-3.5 和 GPT-4 平均提升约 20 个百分点。}
}

@article{shinn2023reflexion,
  title   = {Reflexion: Language Agents with Verbal Reinforcement Learning},
  author  = {Shinn, Noah and Cassano, Federico and Berman, Edward and Gopinath, Ashwin and Narasimhan, Karthik and Yao, Shunyu},
  year    = {2023},
  journal = {arXiv preprint arXiv:2303.11366},
  eprint  = {2303.11366},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2303.11366},
  note    = {NeurIPS 2023; verbal reinforcement, episodic reflection memory},
  further = {no},
  tldr    = {Reflexion reinforces LLM agents without weight updates by storing verbal self-reflections in episodic memory, achieving 91\% pass@1 on HumanEval.},
  tldr-zh = {Reflexion 通过将语言自我反思存储在情节记忆中来强化大语言模型智能体，无需更新权重，在 HumanEval 上达到 91\% 的 pass@1 准确率。}
}

@article{asai2023selfrag,
  title   = {Self-RAG: Learning to Retrieve, Generate, and Critique through Self-Reflection},
  author  = {Asai, Akari and Wu, Zeqiu and Wang, Yizhong and Sil, Avirup and Hajishirzi, Hannaneh},
  year    = {2023},
  journal = {arXiv preprint arXiv:2310.11511},
  eprint  = {2310.11511},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2310.11511},
  note    = {ICLR 2024; reflection tokens},
  further = {no},
  tldr    = {SELF-RAG trains a language model to adaptively retrieve passages on demand and critique its own generations using special reflection tokens, improving factuality without sacrificing versatility.},
  tldr-zh = {SELF-RAG 训练大语言模型按需自适应检索段落，并通过特殊反思词元对自身生成内容进行评判，在不损失通用性的前提下提升事实准确性。}
}

@article{huang2024selfcorrect,
  title   = {Large Language Models Cannot Self-Correct Reasoning Yet},
  author  = {Huang, Jie and Chen, Xinyun and Mishra, Swaroop and Zheng, Huaixiu Steven and Yu, Adams Wei and Song, Xinying and Zhou, Denny},
  year    = {2024},
  journal = {arXiv preprint arXiv:2310.01798},
  eprint  = {2310.01798},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2310.01798},
  note    = {ICLR 2024; intrinsic self-correction fails on reasoning},
  further = {no},
  tldr    = {LLMs cannot self-correct reasoning without external feedback; intrinsic self-correction consistently degrades accuracy on reasoning benchmarks across GPT-3.5, GPT-4, and Llama-2.},
  tldr-zh = {大语言模型（LLM）在没有外部反馈的情况下无法自我纠正推理，内在自我纠正在 GPT-3.5、GPT-4 和 Llama-2 的推理基准上一致导致准确率下降。}
}

@article{kumar2025overthink,
  title   = {OverThink: Slowdown Attacks on Reasoning LLMs},
  author  = {Kumar, Abhinav and Roh, Jaechul and Naseh, Ali and Karpinska, Marzena and Iyyer, Mohit and Houmansadr, Amir and Bagdasarian, Eugene},
  year    = {2025},
  journal = {arXiv preprint arXiv:2502.02542},
  eprint  = {2502.02542},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2502.02542},
  tldr    = {OverThink shows that decoy reasoning problems in retrieved content can make reasoning LLMs spend many more reasoning tokens while still returning contextually correct answers.},
  tldr-zh = {OverThink 表明，检索内容中的诱饵推理题能让推理模型消耗更多思考词元，同时仍给出上下文上正确的答案。}
}

@article{si2025excessive,
  title   = {Excessive Reasoning Attack on Reasoning LLMs},
  author  = {Si, Wai Man and Li, Mingjie and Backes, Michael and Zhang, Yang},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.14374},
  eprint  = {2506.14374},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.14374},
  tldr    = {This attack crafts inputs that trigger excessive reasoning and delayed termination in reasoning models, increasing reasoning length by several times while preserving utility.},
  tldr-zh = {本文构造能触发过度推理与延迟终止的输入，使推理模型在保持任务效用的同时，将推理长度提高数倍。}
}

@article{ghosal2025thinking,
  title   = {Does Thinking More always Help? Understanding Test-Time Scaling in Reasoning Models},
  author  = {Ghosal, Soumya Suvra and Chakraborty, Souradip and Reddy, Avinash and Lu, Yifu and Wang, Mengdi and Manocha, Dinesh and Huang, Furong and Ghavamzadeh, Mohammad and Bedi, Amrit Singh},
  year    = {2025},
  journal = {arXiv preprint arXiv:2506.04210},
  eprint  = {2506.04210},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2506.04210},
  tldr    = {This paper reports a non-monotonic test-time thinking curve: additional thinking first helps and then hurts, motivating parallel thinking and adaptive budget allocation.},
  tldr-zh = {本文报告测试时思考长度呈非单调曲线：额外思考先有帮助，随后伤害表现，因而需要并行思考与自适应预算分配。}
}

@article{zhu2025concise,
