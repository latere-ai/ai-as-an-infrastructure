}

@article{yang2026rwttt,
  title         = {{RW-TTT}: Batched Serving for Request-Owned Test-Time Training State},
  author        = {Yang, Jian and Kou, Zhizhuo and Tian, Yao and Zhang, Hao and Chen, Han and Han, Sirui and Guo, Yike},
  year          = {2026},
  journal       = {arXiv preprint arXiv:2605.28053},
  eprint        = {2605.28053},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2605.28053},
  note          = {batching when each request owns its weights},
  note-zh       = {每个请求各自持有权重时如何批处理},
  tldr          = {Test-time training breaks batched serving, which assumes shared static weights; tagging each decode step with owner, version, and read or write effect lets compatible steps batch safely.},
  tldr-zh       = {测试时训练打破了批处理服务“所有请求共享同一份静态权重”的前提；给每个解码步骤标注所属请求、版本和读写类型后，兼容的步骤就能安全地合批。},
  further       = {no}
}
