  author        = {Tandon, Arnuv and Dalal, Karan and Li, Xinhao and Koceja, Daniel and R{\o}d, Marcel and Buchanan, Sam and Wang, Xiaolong and Leskovec, Jure and Koyejo, Sanmi and Hashimoto, Tatsunori and Guestrin, Carlos and McCaleb, Jed and Choi, Yejin and Sun, Yu},
  year          = {2025},
  journal       = {arXiv preprint arXiv:2512.23675},
  eprint        = {2512.23675},
  archivePrefix = {arXiv},
  url           = {https://arxiv.org/abs/2512.23675},
  note          = {long context as continual learning inside the request},
  note-zh       = {把长上下文当作请求内部的持续学习},
  tldr          = {TTT-E2E keeps training a sliding-window transformer by next-token prediction on the context it reads, scaling with context length like full attention while keeping inference latency constant.},
  tldr-zh       = {TTT-E2E 让滑动窗口 Transformer 在读取上下文时继续用下一词元预测训练自身，随上下文长度的扩展规律与全注意力相同，推断延迟却保持不变。},
