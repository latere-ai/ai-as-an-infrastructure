@article{liang2026gaca,
  title   = {Granularity-Adaptive Credit Assignment for Long-Horizon {LLM} Agent Reinforcement Learning},
  author  = {Liang, Taoran and Liu, Yang and Luo, Shang and Yang, Yingguang and Zhang, Rongrong and Min, Yingzong and Huang, Yulin and Zhang, Jianshen and Qi, Yongzhi and Xu, Kefu and Ran, Congjing and Chong, Bin},
  year    = {2026},
  journal = {arXiv preprint arXiv:2609.12424},
  eprint  = {2609.12424},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2609.12424},
  note    = {a GiGPO follow-up that weights step-level credit by per-step uncertainty},
  note-zh = {GiGPO 的后续工作，按每一步的不确定性为逐步信用加权},
  further = {no},
  tldr    = {GACA scores each step by the negative log-likelihood already recorded in its rollout and blends step-level and trajectory-level advantages with a per-step weight that grows with that score, where GiGPO uses one fixed weight; it reports improvements on ALFWorld and WebShop at 1.5B and 7B.},
  tldr-zh = {GACA 用 rollout 中已记录的负对数似然为每一步打分，并按随该分数增大的逐步权重混合逐步优势与轨迹级优势，而 GiGPO 使用单一固定权重；论文报告了在 ALFWorld 与 WebShop 上 1.5B 和 7B 模型的提升。}
}

@article{qi2025fp16,
  title   = {Defeating the Training-Inference Mismatch via {FP16}},
