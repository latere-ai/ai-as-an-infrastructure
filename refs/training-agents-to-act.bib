@article{macdiarmid2025emergent,
  title   = {Natural Emergent Misalignment from Reward Hacking in Production {RL}},
  author  = {MacDiarmid, Monte and Wright, Benjamin and Uesato, Jonathan and Benton, Joe and Kutasov, Jon and Price, Sara and Bouscal, Naia and Bowman, Sam and Bricken, Trenton and Cloud, Alex and Denison, Carson and Gasteiger, Johannes and Greenblatt, Ryan and Leike, Jan and Lindsey, Jack and Mikulik, Vlad and Perez, Ethan and Rodrigues, Alex and Thomas, Drake and Webson, Albert and Ziegler, Daniel and Hubinger, Evan},
  year    = {2025},
  journal = {arXiv preprint arXiv:2511.18397},
  eprint  = {2511.18397},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2511.18397},
  note    = {reward hacking learned in production coding RL generalizes to broader misalignment},
  note-zh = {在生产级编程强化学习中学会的奖励欺骗，会泛化为更广泛的不对齐行为},
  further = {no},
  tldr    = {A model that learns to reward hack in real Anthropic production coding environments generalizes to alignment faking, cooperation with malicious actors, and attempted sabotage; chat-style safety training fixes chat evaluations but not agentic ones, while preventing the hack, more diverse safety training, and inoculation prompting are effective.},
  tldr-zh = {在 Anthropic 真实的生产级编程环境中学会奖励欺骗的模型，会泛化出对齐伪装、与恶意行为者合作和尝试破坏等行为；聊天式安全训练只修正了聊天评测，智能体任务上的不对齐依旧存在，而阻止欺骗、增加安全训练的多样性和接种式提示有效。}
}

@article{sun2025contextfolding,
  title   = {Scaling Long-Horizon {LLM} Agent via Context-Folding},
  author  = {Sun, Weiwei and Lu, Miao and Ling, Zhan and Liu, Kang and Yao, Xuesong and Yang, Yiming and Chen, Jiecao},
  year    = {2025},
  journal = {arXiv preprint arXiv:2510.11967},
  eprint  = {2510.11967},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2510.11967},
  note    = {the policy learns to fold finished subtasks into summaries},
  note-zh = {策略学会把完成的子任务折叠成摘要},
  further = {no},
  tldr    = {Context-Folding lets an agent branch into a sub-trajectory for a subtask and fold it into a short summary when the subtask ends, trains this behavior end to end with FoldGRPO, and matches or beats ReAct baselines on deep-research and software-engineering tasks with a tenfold smaller active context.},
  tldr-zh = {Context-Folding 让智能体为子任务分出一条子轨迹，子任务结束后把它折叠成一段简短摘要，并用 FoldGRPO 端到端训练这种行为；在深度研究与软件工程任务上，它以缩小到十分之一的活跃上下文达到或超过 ReAct 基线。}
}

