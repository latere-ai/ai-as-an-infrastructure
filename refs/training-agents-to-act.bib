}

@article{dong2025arpo,
  title   = {Agentic Reinforced Policy Optimization},
  author  = {Dong, Guanting and Mao, Hangyu and Ma, Kai and Bao, Licheng and Chen, Yifei and others},
  year    = {2025},
  journal = {arXiv preprint arXiv:2507.19849},
  eprint  = {2507.19849},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2507.19849},
  note    = {ARPO; branches sampling at high-entropy tool-call steps for tool-use credit},
  further = {no},
  tldr    = {ARPO is an agentic RL algorithm for multi-turn LLM agents that uses entropy-based adaptive rollout to branch sampling at high-uncertainty tool-use steps, halving the tool-call budget needed by trajectory-level methods.},
  tldr-zh = {ARPO 是一种面向多轮 LLM 智能体的智能体强化学习算法，通过基于熵的自适应 rollout 在高不确定性工具调用步骤分支采样，将可验证奖励的强化学习（RLVR）所需工具调用预算减半。}
}

@article{singh2025artist,
  title   = {Agentic Reasoning and Tool Integration for LLMs via Reinforcement Learning},
  author  = {Singh, Joykirat and Magazine, Raghav and Pandya, Yash and Nambi, Akshay},
  year    = {2025},
  journal = {arXiv preprint arXiv:2505.01441},
  eprint  = {2505.01441},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2505.01441},
  note    = {ARTIST; interleaves tool calls into the reasoning chain under an outcome reward},
  further = {no},
  tldr    = {ARTIST is a unified framework that couples agentic reasoning, reinforcement learning via GRPO, and dynamic tool integration for LLMs, achieving up to 22% absolute improvement on math benchmarks.},
