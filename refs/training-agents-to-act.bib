@article{nakano2021webgpt,
  title   = {WebGPT: Browser-assisted Question-answering with Human Feedback},
  author  = {Nakano, Reiichiro and Hilton, Jacob and Balaji, Suchir and Wu, Jeff and Ouyang, Long and Kim, Christina and Hesse, Christopher and Jain, Shantanu and Kosaraju, Vineet and Saunders, William and others},
  year    = {2021},
  journal = {arXiv preprint arXiv:2112.09332},
  eprint  = {2112.09332},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2112.09332},
  note    = {early tool-use loop; best model used behavior cloning + rejection sampling},
  further = {no},
  tldr    = {WebGPT fine-tunes GPT-3 to answer long-form questions by browsing the web via a text-based environment, trained with imitation learning and optimized with human feedback using reward modeling and rejection sampling.},
  tldr-zh = {WebGPT 通过文本浏览器环境对 GPT-3 进行微调，使其能搜索网页回答长篇问题，并结合模仿学习与基于人类反馈的强化学习（RLHF）中的奖励模型和拒绝采样进行优化。}
}

@article{jin2025searchr1,
  title   = {Search-R1: Training LLMs to Reason and Leverage Search Engines with Reinforcement Learning},
  author  = {Jin, Bowen and Zeng, Hansi and Yue, Zhenrui and Yoon, Jinsung and Arik, Sercan and Wang, Dong and Zamani, Hamed and Han, Jiawei},
  year    = {2025},
