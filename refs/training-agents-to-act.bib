@inproceedings{feng2025gigpo,
  title     = {Group-in-Group Policy Optimization for LLM Agent Training},
  author    = {Feng, Lang and Xue, Zhenghai and Liu, Tingcong and An, Bo},
  year      = {2025},
  booktitle = {NeurIPS 2025},
  eprint    = {2505.10978},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2505.10978},
  note      = {GiGPO; anchor-state grouping gives critic-free step-level advantages},
  further = {no},
  tldr    = {GiGPO proposes a two-level group-based RL algorithm for multi-turn LLM agent training that achieves fine-grained per-step credit assignment via anchor state grouping, without extra rollouts or critic models.},
