@article{ma2025r3,
  title   = {Stabilizing {MoE} Reinforcement Learning by Aligning Training and Inference Routers},
  author  = {Ma, Wenhan and Zhang, Hailin and Zhao, Liang and Song, Yifan and Wang, Yudong and Sui, Zhifang and Luo, Fuli},
  year    = {2025},
  journal = {arXiv preprint arXiv:2510.11370},
  eprint  = {2510.11370},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2510.11370},
  note    = {Rollout Routing Replay: replay the inference engine's expert routing in the trainer},
  note-zh = {Rollout Routing Replay：在训练器中重放推断引擎的专家路由},
  further = {no},
  tldr    = {The paper shows that mixture-of-experts routers can choose different experts in training and inference, which can collapse RL training, and proposes Rollout Routing Replay (R3), which records the inference engine's routing and replays it during training, reducing the training-inference KL divergence and outperforming GSPO and TIS.},
  tldr-zh = {这篇论文指出，混合专家模型的路由器在训练与推断时可能选中不同的专家，进而导致强化学习训练崩溃；作者提出 Rollout Routing Replay（R3），记录推断引擎的路由并在训练时重放，降低了训练与推断之间的 KL 散度，效果优于 GSPO 和 TIS。}
}

@article{yang2026t1,
  title   = {{T1}: Terminal Agent Reinforcement Learning for Long-Horizon Tasks},
  author  = {Yang, Junyao and Shi, Yucheng and Li, Zhongzhi and Wang, Ruhan and Li, Zongxia and Mi, Haitao and Liang, Leowei},
  year    = {2026},
  journal = {arXiv preprint arXiv:2609.11042},
  eprint  = {2609.11042},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2609.11042},
  note    = {122B MoE terminal agent; exact sampled token IDs plus routing replay},
  note-zh = {122B 混合专家终端智能体；按原样采样的词元 ID 训练，并重放路由},
  further = {no},
  tldr    = {T1 trains a 122-billion-parameter mixture-of-experts model with reinforcement learning to operate a real shell for up to 300+ tool-call turns per task, and reports that training on the exact sampled token IDs together with rollout routing replay cuts the training-to-inference log-probability difference from 0.021 to 0.013.},
  tldr-zh = {T1 用强化学习训练一个 1,220 亿参数的混合专家模型，让它在真实 shell 中每个任务最多执行 300 多轮工具调用；报告称，按原样采样的词元 ID 训练并配合 rollout 路由重放，可把训练与推断之间的对数概率差从 0.021 降到 0.013。}
}
