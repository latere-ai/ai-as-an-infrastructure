}

@article{zheng2025m2po,
  title   = {Prosperity before Collapse: How Far Can Off-Policy RL Reach with Stale Data on LLMs?},
  author  = {Zheng, Haizhong and Zhao, Jiawei and Chen, Beidi},
  year    = {2025},
  journal = {arXiv preprint arXiv:2510.01161},
  eprint  = {2510.01161},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2510.01161},
  note    = {M2PO; constrains the second moment of importance weights for stable stale-data training},
  further = {no},
  tldr    = {M2PO constrains the second moment of importance weights to enable stable off-policy RL training on LLMs with data stale by up to 256 model updates, matching on-policy GRPO performance.},
  tldr-zh = {M2PO 通过约束重要性权重的二阶矩，使大语言模型在数据陈旧达 256 次模型更新时仍能稳定地进行离策略强化学习训练，并达到与在策略 GRPO 相当的性能。}
}
