@article{hu2024openrlhf,
  title   = {OpenRLHF: An Easy-to-use, Scalable and High-performance RLHF Framework},
  author  = {Hu, Jian and others},
  year    = {2024},
  journal = {arXiv preprint arXiv:2405.11143},
