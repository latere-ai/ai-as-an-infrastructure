}

@article{qian2025toolrl,
  title   = {ToolRL: Reward is All Tool Learning Needs},
  author  = {Qian, Cheng and Acikgoz, Emre Can and He, Qi and Wang, Hongru and Chen, Xiusi and Hakkani-T{\"u}r, Dilek and Tur, Gokhan and Ji, Heng},
  year    = {2025},
