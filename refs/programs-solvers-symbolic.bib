  eprint  = {2211.10435},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2211.10435},
  tldr    = {Program-aided Language Models use LLMs to translate natural-language reasoning problems into executable programs, then offload computation to a Python interpreter.},
