  author  = {Yao, Shunyu and Zhao, Jeffrey and Yu, Dian and Du, Nan and Shafran, Izhak and Narasimhan, Karthik and Cao, Yuan},
  year    = {2022},
  journal = {arXiv preprint arXiv:2210.03629},
  eprint  = {2210.03629},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2210.03629},
  tldr    = {ReAct interleaves reasoning traces and task-specific actions, letting LLMs update plans with external observations from tools or environments.},
  tldr-zh = {ReAct 将推理轨迹与任务动作交错起来，使大语言模型能利用来自工具或环境的外部观察更新计划。}
