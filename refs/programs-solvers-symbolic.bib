@article{gao2022pal,
  title   = {PAL: Program-aided Language Models},
  author  = {Gao, Luyu and Madaan, Aman and Zhou, Shuyan and Alon, Uri and Liu, Pengfei and Yang, Yiming and Callan, Jamie and Neubig, Graham},
  year    = {2022},
  journal = {arXiv preprint arXiv:2211.10435},
  eprint  = {2211.10435},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2211.10435},
  tldr    = {Program-aided Language Models use LLMs to translate natural-language reasoning problems into executable programs, then offload computation to a Python interpreter.},
  tldr-zh = {PAL 让大语言模型把自然语言推理题翻译成可执行程序，再把计算交给 Python 解释器完成。}
}

@article{chen2022program,
  title   = {Program of Thoughts Prompting: Disentangling Computation from Reasoning for Numerical Reasoning Tasks},
  author  = {Chen, Wenhu and Ma, Xueguang and Wang, Xinyi and Cohen, William W.},
  year    = {2022},
  journal = {arXiv preprint arXiv:2211.12588},
  eprint  = {2211.12588},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2211.12588},
  tldr    = {Program of Thoughts prompting asks LLMs to express numerical reasoning as executable programs, separating reasoning decomposition from exact computation.},
  tldr-zh = {Program of Thoughts 提示让大语言模型把数值推理表达成可执行程序，从而把推理分解与精确计算分离。}
}

@article{lyu2023faithful,
  title   = {Faithful Chain-of-Thought Reasoning},
  author  = {Lyu, Qing and Havaldar, Shreya and Stein, Adam and Zhang, Li and Rao, Delip and Wong, Eric and Apidianaki, Marianna and Callison-Burch, Chris},
  year    = {2023},
  journal = {arXiv preprint arXiv:2301.13379},
  eprint  = {2301.13379},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2301.13379},
  tldr    = {Faithful CoT translates natural-language queries into symbolic reasoning chains and uses deterministic solvers, making the executed chain causally responsible for the final answer.},
  tldr-zh = {Faithful CoT 将自然语言问题翻译成符号推理链并交给确定性求解器，使被执行的链条成为最终答案的因果来源。}
}

@article{yao2022react,
  title   = {ReAct: Synergizing Reasoning and Acting in Language Models},
  author  = {Yao, Shunyu and Zhao, Jeffrey and Yu, Dian and Du, Nan and Shafran, Izhak and Narasimhan, Karthik and Cao, Yuan},
  year    = {2022},
  journal = {arXiv preprint arXiv:2210.03629},
  eprint  = {2210.03629},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2210.03629},
  tldr    = {ReAct interleaves reasoning traces and task-specific actions, letting LLMs update plans with external observations from tools or environments.},
  tldr-zh = {ReAct 将推理轨迹与任务动作交错起来，使大语言模型能利用来自工具或环境的外部观察更新计划。}
}

@article{hubert2025alphaproof,
  title   = {Olympiad-level formal mathematical reasoning with reinforcement learning},
  author  = {Hubert, Thomas and Mehta, Rishi and Sartran, Laurent and others},
  year    = {2025},
  journal = {Nature},
  url     = {https://www.nature.com/articles/s41586-025-09833-y},
  note    = {AlphaProof; published online 12 November 2025, in print as Nature 651, 607--613 (2026)},
  tldr    = {AlphaProof trains an AlphaZero-style RL agent to write Lean proofs, using millions of auto-formalized problems, and reached silver-medal standard on the 2024 IMO problems; autoformalization is the limiting step.},
  tldr-zh = {AlphaProof 用 AlphaZero 式强化学习训练智能体写 Lean 证明，训练题来自数百万道自动形式化的问题，在 2024 年 IMO 题目上达到银牌水平；自动形式化是其瓶颈。}
}

@article{ren2025deepseekprover,
  title   = {DeepSeek-Prover-V2: Advancing Formal Mathematical Reasoning via Reinforcement Learning for Subgoal Decomposition},
  author  = {Ren, Z. Z. and Shao, Zhihong and Song, Junxiao and Xin, Huajian and Wang, Haocheng and Zhao, Wanjia and Zhang, Liyue and Fu, Zhe and Zhu, Qihao and Yang, Dejian and Wu, Z. F. and Gou, Zhibin and Ma, Shirong and Tang, Hongxuan and Liu, Yuxuan and Gao, Wenjun and Guo, Daya and Ruan, Chong},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.21801},
  eprint  = {2504.21801},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.21801},
  note    = {Lean 4 proof search with recursive decomposition and RL; 88.9% on miniF2F-test},
  tldr    = {DeepSeek-Prover-V2 combines informal and formal reasoning for Lean 4 theorem proving, using recursive subgoal decomposition and RL to reach 88.9% on miniF2F-test.},
  tldr-zh = {DeepSeek-Prover-V2 把非形式化与形式化推理结合到 Lean 4 定理证明中，通过递归子目标分解与强化学习在 miniF2F-test 上达到 88.9%。}
}
