  author  = {Ren, Z. Z. and Shao, Zhihong and Song, Junxiao and Xin, Huajian and Wang, Haocheng and Zhao, Wanjia and Zhang, Liyue and Fu, Zhe and Zhu, Qihao and Yang, Dejian and Wu, Z. F. and Gou, Zhibin and Ma, Shirong and Tang, Hongxuan and Liu, Yuxuan and Gao, Wenjun and Guo, Daya and Ruan, Chong},
  year    = {2025},
  journal = {arXiv preprint arXiv:2504.21801},
  eprint  = {2504.21801},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2504.21801},
  note    = {DeepSeek-Prover-V2-671B reached 82.4\% Pass@32 and 88.9\% Pass@8192 on miniF2F-test},
  tldr    = {DeepSeek-Prover-V2 trains Lean 4 theorem provers with subgoal-derived cold-start data and reinforcement learning; its 671B model reached 88.9\% Pass@8192 on already-formalized miniF2F-test statements.},
  tldr-zh = {DeepSeek-Prover-V2 用子目标生成的冷启动数据与强化学习训练 Lean 4 定理证明器；其 671B 模型在已形式化的 miniF2F-test 命题上以 Pass@8192 达到 88.9\%。}
}

