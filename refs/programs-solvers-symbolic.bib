@article{gao2022pal,
  title   = {PAL: Program-aided Language Models},
  author  = {Gao, Luyu and Madaan, Aman and Zhou, Shuyan and Alon, Uri and Liu, Pengfei and Yang, Yiming and Callan, Jamie and Neubig, Graham},
  year    = {2022},
