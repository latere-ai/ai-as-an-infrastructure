  tldr-zh = {ReAct 将推理轨迹与任务动作交错起来，使大语言模型能利用来自工具或环境的外部观察更新计划。}
}

@article{hubert2025alphaproof,
  title   = {Olympiad-level formal mathematical reasoning with reinforcement learning},
  author  = {Hubert, Thomas and Mehta, Rishi and Sartran, Laurent and others},
  year    = {2026},
  journal = {Nature},
  volume  = {651},
  pages   = {607--613},
  doi     = {10.1038/s41586-025-09833-y},
  url     = {https://www.nature.com/articles/s41586-025-09833-y},
  note    = {Published online 12 November 2025; version of record 13 March 2026},
  tldr    = {AlphaProof uses AlphaZero-style reinforcement learning and Lean verification; it solved three manually formalized non-geometry problems at IMO 2024, while the combined AlphaProof and AlphaGeometry 2 system reached a silver-equivalent score.},
  tldr-zh = {AlphaProof 采用 AlphaZero 式强化学习与 Lean 验证，在 2024 年 IMO 中解出三道经人工形式化的非几何题；AlphaProof 与 AlphaGeometry 2 的组合系统达到银牌等效分数。}
}

@article{ren2025deepseekprover,
