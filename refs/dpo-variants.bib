@inproceedings{rafailov2023dpo,
  title     = {Direct Preference Optimization: Your Language Model is Secretly a Reward Model},
  author    = {Rafailov, Rafael and Sharma, Archit and Mitchell, Eric and Ermon, Stefano and Manning, Christopher D. and Finn, Chelsea},
  year      = {2023},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint    = {2305.18290},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2305.18290},
  note      = {DPO},
  tldr    = {DPO replaces RLHF's explicit reward model and RL loop with a simple binary cross-entropy loss, extracting the optimal policy directly from human preference data.},
  tldr-zh = {DPO 用简单的二元交叉熵损失替代基于人类反馈的强化学习（RLHF）中的显式奖励模型与强化学习循环，直接从人类偏好数据中提取最优策略。}
}

@inproceedings{azar2023ipo,
  title   = {A General Theoretical Paradigm to Understand Learning from Human Preferences},
  author  = {Gheshlaghi Azar, Mohammad and Daniel Guo, Zhaohan and Piot, Bilal and Munos, Remi and Rowland, Mark and Valko, Michal and Calandriello, Daniele},
  year    = {2024},
  booktitle = {Proceedings of the 27th International Conference on Artificial Intelligence and Statistics},
  series  = {Proceedings of Machine Learning Research},
  volume  = {238},
  pages   = {4447--4455},
  publisher = {PMLR},
  eprint  = {2310.12036},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2310.12036},
  note    = {IPO},
  tldr    = {This paper introduces ΨPO, a general preference optimization objective that unifies RLHF and DPO as special cases, and proposes IPO, which bypasses the Bradley-Terry assumption to avoid overfitting.},
  tldr-zh = {本文提出 ΨPO 通用偏好优化目标，将 RLHF 与 DPO 统一为特例，并推导出 IPO 以绕过 Bradley-Terry 假设从而避免过拟合。}
}

@inproceedings{ethayarajh2024kto,
  title   = {Model Alignment as Prospect Theoretic Optimization},
  author  = {Ethayarajh, Kawin and Xu, Winnie and Muennighoff, Niklas and Jurafsky, Dan and Kiela, Douwe},
  year    = {2024},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning},
  series  = {Proceedings of Machine Learning Research},
  volume  = {235},
  pages   = {12634--12651},
  publisher = {PMLR},
  eprint  = {2402.01306},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2402.01306},
  tldr    = {KTO aligns LLMs using a Kahneman-Tversky prospect theory objective that learns from binary desirability signals instead of preference pairs, matching or exceeding DPO at scales from 1B to 30B parameters.},
  tldr-zh = {KTO 基于 Kahneman-Tversky 前景理论提出对齐目标，仅需二元可取性信号而非偏好对，在 1B 到 30B 参数规模上与 DPO 持平或更优。}
}

@inproceedings{hong2024orpo,
  title   = {ORPO: Monolithic Preference Optimization without Reference Model},
  author  = {Hong, Jiwoo and Lee, Noah and Thorne, James},
  year    = {2024},
  booktitle = {Proceedings of the 2024 Conference on Empirical Methods in Natural Language Processing},
  pages   = {11170--11189},
  publisher = {Association for Computational Linguistics},
  doi     = {10.18653/v1/2024.emnlp-main.626},
  eprint  = {2403.07691},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2403.07691},
  tldr    = {ORPO is a monolithic preference alignment algorithm that merges SFT and preference optimization into one step using an odds ratio penalty, eliminating the need for a reference model.},
  tldr-zh = {ORPO 是一种单体偏好对齐算法，通过在监督微调（SFT）损失中附加优势比惩罚项，将 SFT 与偏好优化合并为单步训练，无需参考模型。}
}

@inproceedings{meng2024simpo,
  title     = {SimPO: Simple Preference Optimization with a Reference-Free Reward},
  author    = {Meng, Yu and Xia, Mengzhou and Chen, Danqi},
  year      = {2024},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  eprint    = {2405.14734},
  archivePrefix = {arXiv},
  url       = {https://arxiv.org/abs/2405.14734},
  tldr    = {SimPO replaces DPO's reference-model reward with a length-normalized average log probability and a target reward margin, eliminating the reference model while outperforming DPO by up to 7.5 points on Arena-Hard.},
  tldr-zh = {SimPO 用长度归一化的平均对数概率替代 DPO 的参考模型奖励，并引入目标奖励间隔，无需参考模型，在 Arena-Hard 上比 DPO 最多提升 7.5 个百分点。}
}

@article{schulman2017proximal,
  title   = {Proximal Policy Optimization Algorithms},
  author  = {Schulman, John and Wolski, Filip and Dhariwal, Prafulla and Radford, Alec and Klimov, Oleg},
  year    = {2017},
  journal = {arXiv preprint arXiv:1707.06347},
  eprint  = {1707.06347},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/1707.06347},
  note    = {PPO},
  tldr    = {PPO introduces a clipped surrogate objective for policy gradient reinforcement learning that achieves TRPO-level reliability with simpler first-order optimization and better sample complexity.},
  tldr-zh = {PPO 提出裁剪代理目标函数，使策略梯度强化学习在仅用一阶优化的条件下达到 TRPO 的可靠性，并具备更优的样本复杂度。}
}

@article{li2026posttraining,
  title   = {Do Post-Training Algorithms Actually Differ? A Controlled Study Across Model Scales Uncovers Scale-Dependent Ranking Inversions},
  author  = {Li, Xiaoyi},
  year    = {2026},
  journal = {arXiv preprint arXiv:2603.19335},
  eprint  = {2603.19335},
  archivePrefix = {arXiv},
  url     = {https://arxiv.org/abs/2603.19335},
  further = {no},
  tldr    = {A controlled study finds that post-training algorithm rankings depend on model scale and task, and that no tested DPO variant significantly beats DPO in its 1.5B GSM8K sweep after multiple-comparison correction.},
  tldr-zh = {一项受控研究发现，训练后算法的排名取决于模型规模和任务；在其 1.5B GSM8K 扫描中，多重比较校正后没有受测 DPO 变体显著优于 DPO。}
}

@inproceedings{spangher2025rlhf,
  title     = {RLHF Algorithms Ranked: An Extensive Evaluation Across Diverse Tasks, Rewards, and Hyperparameters},
  author    = {Spangher, Lucas and Pasumarthi, Rama Kumar and Masiewicki, Nick and Arnold, William F. and Kaushal, Aditi and Johnson, Dale and Grabowski, Peter and Ie, Eugene},
  year      = {2025},
  booktitle = {Proceedings of the 2025 Conference on Empirical Methods in Natural Language Processing: Industry Track},
  pages     = {518--529},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2025.emnlp-industry.35},
  url       = {https://aclanthology.org/2025.emnlp-industry.35/},
  further   = {no},
  tldr      = {A broad empirical comparison finds that alignment-method rankings depend on task, reward, and hyperparameter choices rather than yielding one universal winner.},
  tldr-zh   = {一项广泛的实证比较发现，对齐方法的排名取决于任务、奖励和超参数选择，并不存在一个普遍的赢家。}
}

@inproceedings{saeidi2025systematic,
  title     = {Insights into Alignment: Evaluating DPO and its Variants Across Multiple Tasks},
  author    = {Saeidi, Amir and Verma, Shivanshu and Uddin, Md Nayem and Baral, Chitta},
  year      = {2025},
  booktitle = {Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (Volume 4: Student Research Workshop)},
  pages     = {409--421},
  publisher = {Association for Computational Linguistics},
  doi       = {10.18653/v1/2025.acl-srw.26},
  url       = {https://aclanthology.org/2025.acl-srw.26/},
  further   = {no},
  tldr      = {A comparison of DPO, IPO, KTO, and CPO across tasks and initialization regimes finds that the leading method varies by setting.},
  tldr-zh   = {一项跨任务和初始化方式的 DPO、IPO、KTO 与 CPO 比较发现，领先方法会随设置变化。}
}
