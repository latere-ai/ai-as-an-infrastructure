@inproceedings{marchisio2024quantized,
  title        = {How Does Quantization Affect Multilingual {LLM}s?},
  author       = {Marchisio, Kelly and Dash, Saurabh and Chen, Hongyu and Aumiller, Dennis and {\"U}st{\"u}n, Ahmet and Hooker, Sara and Ruder, Sebastian},
  year         = {2024},
  booktitle    = {Findings of the Association for Computational Linguistics: EMNLP 2024},
  pages        = {15928--15947},
  publisher    = {Association for Computational Linguistics},
  doi          = {10.18653/v1/2024.findings-emnlp.935},
  url          = {https://aclanthology.org/2024.findings-emnlp.935/},
  tldr         = {Across the evaluated multilingual models, languages and tasks were affected unevenly by quantization, and automatic metrics understated some changes observed by human evaluators.},
  tldr-zh      = {在论文评估的多语言模型中，不同语言与任务受量化影响不均，自动指标低估了人类评估者观察到的部分变化。}
}
