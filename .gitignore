.DS_Store
__pycache__/
*.pyc
# Agent config is local (settings, worktrees), but skills are shared workflow
# and belong in the repo.
.claude/*
!.claude/skills/

# Build output: compiled from app/ via `bun run build` (or inside the Docker
# build) and embedded into the Go server binary. Not vendored.
_book/*
# ...except the marker that lets `go:embed all:_book` resolve without a build,
# so the Go gates run on a clean clone.
!_book/.gitkeep

# Local-only paper extraction: downloaded papers + extracted text (the grounding
# cache for the `tldr` bib fields) and the extraction script itself. NOT committed
# (copyright); only the derived tldr text lands in refs/*.bib.
.paper-cache/
app/scripts/extract-papers.ts
app/scripts/apply-tldr.ts
app/scripts/collect-papers.ts

# LaTeX intermediates from PDF rendering
*.aux
*.log
*.toc
*.out

# Generated by lateregate on every `make lint-config`; never committed.
.golangci.yml

# Agent instructions live in AGENTS.md; CLAUDE.md is a local symlink to it.
CLAUDE.md

# Generated by lateregate on every run; never committed.
coverage.out
