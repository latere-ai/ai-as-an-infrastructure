.DS_Store
.claude/
practical-research/

# Build output (_book) is VENDORED: the pre-commit hook (.githooks/pre-commit)
# rebuilds it from app/ via `bun run build` and stages it, so the Docker image
# packs committed HTML. Do not ignore _book.
**/.quarto/
**/*_files/

# Quarto execution cache. No executed code cells yet, so this is ignored.
# If chapters start executing code, consider committing _freeze for
# reproducible CI renders.
**/_freeze/

# LaTeX intermediates from PDF rendering
*.aux
*.log
*.toc
*.out

# Quarto SCSS css-vars analysis dump (non-fatal Quarto bug, regenerated each render)
_quarto_internal_scss_error.scss
