#!/bin/sh
# Vendored build: recompile the static site from app/ and stage the result so
# every commit carries fresh compiled HTML. The Docker image packs this _book/.
# Enable once per clone: git config core.hooksPath .githooks
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root/app"

# Reader app deps must be present.
if [ ! -d node_modules ]; then
  echo "pre-commit: installing reader deps (app/)…"
  bun install --frozen-lockfile
fi

echo "pre-commit: building _book from app/ …"
bun run build

cd "$root"
git add _book
