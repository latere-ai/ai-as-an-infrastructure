{
  "name": "aaai-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom React + Bun reader for 'AI as an Infrastructure', replacing Quarto.",
  "scripts": {
    "dev": "bun run src/dev.ts",
    "build": "bun run src/build.ts",
    "typecheck": "tsc --noEmit",
    "export": "bun run src/export.ts",
    "og": "bun run src/og.ts"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.34.2",
    "@mdit/plugin-katex": "^0.25.2",
    "@retorquere/bibtex-parser": "^10.0.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-attrs": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
